def track_detached_process(process: subprocess.Popen) -> None:
    DETACHED_PROCESSES.append(process)


def reap_detached_processes() -> None:
    DETACHED_PROCESSES[:] = [process for process in DETACHED_PROCESSES if process.poll() is None]


