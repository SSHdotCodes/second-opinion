def supports_color() -> bool:
    return sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def style(text: str, color: str) -> str:
    if not supports_color():
        return text
    colors = {
        "cyan": "\033[36m",
        "green": "\033[32m",
        "yellow": "\033[33m",
        "red": "\033[31m",
        "bold": "\033[1m",
        "dim": "\033[2m",
    }
    return f"{colors[color]}{text}\033[0m"


def home_dir() -> Path:
    override = os.environ.get("SECOND_OPINION_HOME")
    return Path(override).expanduser() if override else Path.home()


def base_url_from_env() -> str:
    return os.environ.get("SECOND_OPINION_BASE_URL", DEFAULT_BASE_URL).rstrip("/")


def cli_download_url(base_url: str) -> str:
    return f"{base_url.rstrip('/')}/bin/second-opinion"


def parse_cli_version(text: str) -> str | None:
    match = re.search(r'^VERSION\s*=\s*["\']([^"\']+)["\']', text, re.MULTILINE)
    return match.group(1) if match else None


def version_parts(version: str) -> tuple[int, ...]:
    parts = [int(part) for part in re.findall(r"\d+", version)]
    return tuple(parts or [0])


def version_is_newer(remote: str, current: str) -> bool:
    left = version_parts(remote)
    right = version_parts(current)
    size = max(len(left), len(right))
    return left + (0,) * (size - len(left)) > right + (0,) * (size - len(right))


def current_executable_path(override: str | None = None) -> Path:
    if override:
        return Path(override).expanduser().resolve()
    raw = sys.argv[0]
    candidate = raw if os.sep in raw else shutil.which(raw) or raw
    return Path(candidate).expanduser().resolve()


def read_text_bytes(data: bytes) -> str:
    return data.decode("utf-8", errors="replace")


def download_bytes(url: str) -> bytes:
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme == "file":
        file_path = Path(urllib.request.url2pathname(parsed.path))
        try:
            return file_path.read_bytes()
        except OSError as error:
            raise SystemExit(f"Unable to read {file_path}: {error}") from error
    try:
        with urllib.request.urlopen(url, timeout=30) as response:
            return response.read()
    except (urllib.error.URLError, TimeoutError, OSError) as url_error:
        curl = shutil.which("curl")
        if curl:
            completed = subprocess.run(
                [curl, "-fsSL", url],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
            )
            if completed.returncode == 0:
                return completed.stdout
            curl_error = completed.stderr.decode("utf-8", errors="replace").strip()
        else:
            curl_error = "curl not found"

        wget = shutil.which("wget")
        if wget:
            completed = subprocess.run(
                [wget, "-qO-", url],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
            )
            if completed.returncode == 0:
                return completed.stdout
            wget_error = completed.stderr.decode("utf-8", errors="replace").strip()
        else:
            wget_error = "wget not found"

        raise SystemExit(
            f"Unable to download {url}: {url_error}; curl: {curl_error}; wget: {wget_error}"
        ) from url_error


class ScriptCollector(HTMLParser):
    """Collect script bodies without importing a browser or third-party parser."""

    def __init__(self) -> None:
        super().__init__()
        self.in_script = False
        self.current: list[str] = []
        self.scripts: list[str] = []

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        if tag == "script":
            self.in_script = True
            self.current = []

    def handle_data(self, data: str) -> None:
        if self.in_script:
            self.current.append(data)

    def handle_endtag(self, tag: str) -> None:
        if tag == "script" and self.in_script:
            self.scripts.append("".join(self.current))
            self.in_script = False


def next_data_strings(page: str) -> list[str]:
    parser = ScriptCollector()
    parser.feed(page)
    result: list[str] = []
    prefix = "self.__next_f.push("
    for script in parser.scripts:
        if not script.startswith(prefix) or not script.endswith(")"):
            continue
        try:
            payload = json.loads(script[len(prefix) : -1])
        except (json.JSONDecodeError, TypeError):
            continue
        if isinstance(payload, list) and len(payload) > 1 and isinstance(payload[1], str):
            result.append(payload[1])
    return result


def embedded_json_arrays(page: str, key: str) -> list[list[object]]:
    marker = json.dumps(key) + ":"
    decoder = json.JSONDecoder()
    arrays: list[list[object]] = []
    for data in next_data_strings(page):
        position = 0
        while True:
            start = data.find(marker, position)
            if start < 0:
                break
            start += len(marker)
            position = start
            try:
                value, end = decoder.raw_decode(data, start)
            except json.JSONDecodeError:
                continue
            position = end
            if isinstance(value, list):
                arrays.append(value)
    return arrays


def artificial_analysis_index_version(page: str) -> str | None:
    matches = re.findall(r"Intelligence Index v(\d+(?:\.\d+)*)", page, re.IGNORECASE)
    return matches[0] if matches else None


def parse_artificial_analysis_models(page: str) -> dict[str, object]:
    candidates: list[list[object]] = []
    for rows in embedded_json_arrays(page, "initialData"):
        if any(
            isinstance(row, dict)
            and {"slug", "intelligenceIndex", "codingIndex", "agenticIndex"}.issubset(row)
            for row in rows
        ):
            candidates.append(rows)
    if not candidates:
        raise ValueError("Artificial Analysis model data was not found in the public page.")
    rows = max(candidates, key=lambda group: sum(isinstance(item, dict) for item in group))
    models: list[dict[str, object]] = []
    for row in rows:
        if not isinstance(row, dict) or not row.get("slug"):
            continue
        creator = row.get("creator") if isinstance(row.get("creator"), dict) else {}
        cost_container = row.get("intelligenceIndexCostPerTask")
        cost = cost_container.get("cost", {}) if isinstance(cost_container, dict) else {}
        timescale = row.get("timescaleData") if isinstance(row.get("timescaleData"), dict) else {}
        models.append(
            {
                "name": row.get("name"),
                "slug": row.get("slug"),
                "creator": creator.get("name"),
                "reasoning": row.get("isReasoning"),
                "release_date": row.get("releaseDate"),
                "intelligence_index": row.get("intelligenceIndex"),
                "coding_index": row.get("codingIndex"),
                "agentic_index": row.get("agenticIndex"),
                "cost_per_task_usd": cost.get("total") if isinstance(cost, dict) else None,
                "time_per_task_minutes": (
                    float(row["intelligenceIndexTimePerTask"]) / 60
                    if isinstance(row.get("intelligenceIndexTimePerTask"), (int, float))
                    else None
                ),
                "output_tokens_per_second": timescale.get("medianOutputSpeed"),
                "price_1m_input_tokens_usd": row.get("price1mInputTokens"),
                "price_1m_output_tokens_usd": row.get("price1mOutputTokens"),
                "price_1m_cache_hit_tokens_usd": row.get("cacheHitPrice"),
                "url": f"https://artificialanalysis.ai/models/{row.get('slug')}",
            }
        )
    if not models:
        raise ValueError("Artificial Analysis returned no usable model benchmark rows.")
    return {
        "kind": "models",
        "index_version": artificial_analysis_index_version(page),
        "source": "Artificial Analysis",
        "source_url": ARTIFICIAL_ANALYSIS_MODELS_URL,
        "attribution": "Benchmark data by Artificial Analysis (https://artificialanalysis.ai).",
        "models": models,
    }


def parse_artificial_analysis_agents(page: str) -> dict[str, object]:
    by_id: dict[str, dict[str, object]] = {}
    for key in ("rows", "benchmarkRows"):
        for rows in embedded_json_arrays(page, key):
            for row in rows:
                if not isinstance(row, dict) or not row.get("id") or not row.get("displayLabel"):
                    continue
                if not isinstance(row.get("indexScore"), (int, float)):
                    continue
                by_id[str(row["id"])] = row
    if not by_id:
        raise ValueError("Artificial Analysis coding-agent data was not found in the public page.")
    agents: list[dict[str, object]] = []
    for row in by_id.values():
        display = row.get("display") if isinstance(row.get("display"), dict) else {}
        creator = display.get("creator") if isinstance(display.get("creator"), dict) else {}
        mean = row.get("mean") if isinstance(row.get("mean"), dict) else {}
        agents.append(
            {
                "name": row.get("displayLabel"),
                "harness": row.get("agentName"),
                "model": display.get("model"),
                "model_creator": creator.get("model"),
                "coding_agent_index": float(row["indexScore"]) * 100,
                "cost_per_task_usd": mean.get("costUsd"),
                "time_per_task_minutes": (
                    float(mean["agentWallTimeSec"]) / 60
                    if isinstance(mean.get("agentWallTimeSec"), (int, float))
                    else None
                ),
                "steps_per_task": mean.get("steps"),
                "total_tokens_per_task": mean.get("totalTokens"),
            }
        )
    return {
        "kind": "agents",
        "source": "Artificial Analysis",
        "source_url": ARTIFICIAL_ANALYSIS_AGENTS_URL,
        "attribution": "Coding Agent Index data by Artificial Analysis (https://artificialanalysis.ai).",
        "agents": agents,
    }


def benchmark_cache_path(kind: str) -> Path:
    return home_dir() / ".second-opinion" / "cache" / f"artificial-analysis-{kind}.json"


def load_benchmark_data(kind: str, *, refresh: bool = False, offline: bool = False) -> dict[str, object]:
    if kind not in {"models", "agents"}:
        raise ValueError(f"Unknown benchmark kind: {kind}")
    cache_path = benchmark_cache_path(kind)
    cached: dict[str, object] | None = None
    try:
        value = json.loads(cache_path.read_text(encoding="utf-8"))
        if isinstance(value, dict):
            cached = value
    except (OSError, json.JSONDecodeError):
        pass
    fetched_epoch = float(cached.get("fetched_epoch", 0)) if cached else 0
    if cached and (offline or (not refresh and time.time() - fetched_epoch < BENCHMARK_CACHE_SECONDS)):
        result = dict(cached)
        result["cache"] = "hit"
        return result
    if offline:
        raise SystemExit("No cached Artificial Analysis data is available. Run `second-opinion benchmarks` once while online.")

    url = ARTIFICIAL_ANALYSIS_MODELS_URL if kind == "models" else ARTIFICIAL_ANALYSIS_AGENTS_URL
    parser = parse_artificial_analysis_models if kind == "models" else parse_artificial_analysis_agents
    try:
        result = parser(read_text_bytes(download_bytes(url)))
    except (SystemExit, ValueError) as error:
        if not cached:
            raise SystemExit(f"Unable to load keyless Artificial Analysis benchmarks: {error}") from error
        result = dict(cached)
        result["cache"] = "stale-fallback"
        result["warning"] = str(error)
        return result
    result["fetched_at"] = timestamp()
    result["fetched_epoch"] = time.time()
    result["cache"] = "refreshed"
    atomic_write_json(cache_path, result)
    return result


def download_cli(base_url: str) -> tuple[str, bytes, str]:
    url = cli_download_url(base_url)
    data = download_bytes(url)

    text = read_text_bytes(data)
    remote_version = parse_cli_version(text)
    if not data.startswith(b"#!") or "Second Opinion CLI" not in text or not remote_version:
        raise SystemExit(f"Downloaded file from {url} does not look like a valid Second Opinion CLI.")
    return url, data, remote_version


def replace_executable(target: Path, data: bytes) -> None:
    if not target.parent.exists():
        raise SystemExit(f"Install directory does not exist: {target.parent}")

    fd, temp_name = tempfile.mkstemp(prefix=f".{target.name}.", suffix=".update", dir=str(target.parent))
    temp_path = Path(temp_name)
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
        mode = target.stat().st_mode if target.exists() else 0o755
        temp_path.chmod(mode | 0o111)
        os.replace(temp_path, target)
    except OSError as error:
        raise SystemExit(f"Unable to update {target}: {error}") from error
    finally:
        try:
            temp_path.unlink()
        except FileNotFoundError:
            pass


def managed_installed_targets() -> list[str]:
    targets: list[str] = []
    for key, agent in AGENTS.items():
        path = agent_skill_file(agent)
        if not path.exists():
            continue
        try:
            content = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        if MARKER in content:
            targets.append(key)
    return targets


def resolve_agent(name: str) -> Agent:
    needle = name.strip().lower()
    if needle in AGENTS:
        return AGENTS[needle]
    for agent in AGENTS.values():
        if needle in agent.aliases:
            return agent
    valid = ", ".join(AGENTS)
    raise SystemExit(f"Unknown agent '{name}'. Valid agents: {valid}, auto")


def agent_choices() -> list[str]:
    choices: list[str] = []
    for key, agent in AGENTS.items():
        choices.append(key)
        choices.extend(agent.aliases)
    return choices


def agent_skill_file(agent: Agent, base_home: Path | None = None) -> Path:
    return (base_home or home_dir()) / agent.skill_path


def detect_agents() -> dict[str, dict[str, object]]:
    result: dict[str, dict[str, object]] = {}
    base_home = home_dir()
    for key, agent in AGENTS.items():
        command_path = shutil.which(agent.command)
        skill_file = agent_skill_file(agent, base_home)
        result[key] = {
            "name": agent.display,
            "command": agent.command,
            "command_path": command_path,
            "detected": bool(command_path),
            "skill_path": str(skill_file),
            "skill_installed": skill_file.exists(),
            "strengths": agent.strengths,
        }
    return result


def declared_image_tools() -> dict[str, str]:
    """Return optional harness=image-tool declarations from the environment."""
    result: dict[str, str] = {}
    for raw in os.environ.get("SECOND_OPINION_IMAGE_TOOLS", "").split(","):
        item = raw.strip()
        if not item:
            continue
        agent_name, separator, tool_name = item.partition("=")
        try:
            agent = resolve_agent(agent_name.strip())
        except SystemExit:
            continue
        result[agent.key] = tool_name.strip() if separator and tool_name.strip() else "native image tool"
    return result


def declared_image_models() -> dict[str, list[str]]:
    """Return optional harness=model|model declarations for capability output."""
    result: dict[str, list[str]] = {}
    for raw in os.environ.get("SECOND_OPINION_IMAGE_MODELS", "").split(","):
        agent_name, separator, model_names = raw.strip().partition("=")
        if not separator:
            continue
        try:
            agent = resolve_agent(agent_name.strip())
        except SystemExit:
            continue
        models = [model.strip() for model in model_names.split("|") if model.strip()]
        if models:
            result[agent.key] = models
    return result


def image_skill_candidates(agent: Agent, base_home: Path | None = None) -> list[Path]:
    base = base_home or home_dir()
    if agent.key == "codex":
        codex_home = Path(os.environ.get("CODEX_HOME", str(base / ".codex"))).expanduser()
        roots = (codex_home / "skills/.system", codex_home / "skills", base / ".agents/skills")
    elif agent.key == "claude":
        roots = (base / ".claude/skills",)
    elif agent.key == "opencode":
        roots = (base / ".config/opencode/skills",)
    elif agent.key == "grok":
        roots = (base / ".grok/skills",)
    elif agent.key == "antigravity":
        roots = (base / ".gemini/antigravity/skills",)
    else:
        roots = ()
    return [root / name / "SKILL.md" for root in roots for name in IMAGE_SKILL_NAMES]


def detect_image_tools(base_home: Path | None = None) -> dict[str, dict[str, object]]:
    """Discover image creation exposed by installed native coding harnesses."""
    detected_agents = detect_agents()
    declarations = declared_image_tools()
    model_declarations = declared_image_models()
    result: dict[str, dict[str, object]] = {}
    for key, agent in AGENTS.items():
        evidence = next((path for path in image_skill_candidates(agent, base_home) if path.is_file()), None)
        declared_tool = declarations.get(key)
        command_path = detected_agents[key]["command_path"]
        tool = declared_tool or ("imagegen / image_gen" if evidence else None)
        models = model_declarations.get(key, ["provider-default"] if tool else [])
        available = bool(command_path and tool)
        result[key] = {
            "name": agent.display,
            "command": agent.command,
            "command_path": command_path,
            "available": available,
            "tool": tool,
            "source": "declared" if declared_tool else ("skill" if evidence else None),
            "evidence": str(evidence) if evidence else None,
            "model_selection": "provider-native",
            "models": models,
            "note": (
                "Uses the harness's already-authenticated native image tool; Second Opinion does not handle image API keys."
                if available
                else "No image-generation skill or explicit tool declaration was detected. The harness may still be selected explicitly."
            ),
        }
    return result


def choose_image_agent(
    target: str,
    caller: str | None = None,
    *,
    allow_missing_command: bool = False,
) -> tuple[Agent, dict[str, object]]:
    capabilities = detect_image_tools()
    if target != "auto":
        agent = resolve_agent(target)
        if not shutil.which(agent.command) and not allow_missing_command:
            raise SystemExit(f"{agent.display} CLI not found on PATH as `{agent.command}`.")
        return agent, capabilities[agent.key]

    available = [AGENTS[key] for key, info in capabilities.items() if info["available"]]
    if not available:
        raise SystemExit(
            "No image-capable coding harness was detected. Run `second-opinion image-tools` for details, "
            "or select a known image-capable harness explicitly."
        )
    caller_key: str | None = None
    if caller:
        try:
            caller_key = resolve_agent(caller).key
        except SystemExit:
            caller_key = None
    non_callers = [agent for agent in available if agent.key != caller_key]
    agent = (non_callers or available)[0]
    return agent, capabilities[agent.key]


def print_banner() -> None:
    print(style("Second Opinion", "bold"))
    print(style("mix coding agents as safe, opt-in subagents", "dim"))
    print()


def render_target_notes() -> str:
    rows = []
    for agent in AGENTS.values():
        rows.append(f"- `{agent.key}` ({agent.display}): {agent.strengths}")
    return "\n".join(rows)


def render_routing_tips() -> str:
    return dedent(
        """\
        - When model quality, harness performance, or budget matters, query `second-opinion benchmarks --kind models|agents --json` instead of relying only on remembered rankings.
        - For visual UI, frontend polish, responsive layout, copy tone, and product/design judgment, prefer Claude Code with the latest/highest Claude model available to the user, often an Opus-class model when available.
        - For backend work, APIs, data flow, tests, repo-wide edits, debugging, and most general implementation tasks, prefer Codex unless another target has clearly better context or provider access.
        - For quick model-flexible exploration, cheap parallel checks, or trying many configured providers, OpenCode is fast and easy to use; treat output quality as model-dependent and verify more carefully when using smaller or cheaper models.
        - Use Antigravity when Google/Gemini, Vertex, Firebase, Cloud Run, or Google-style orchestration matters.
        - Use Grok Build for broad exploration or implementation spikes when it is installed and the task benefits from speed over precision.
        """
    )


def example_work_target(agent: Agent) -> str:
    if agent.key == "codex":
        return "claude"
    if agent.key == "antigravity":
        return "codex"
    return "codex"


def render_skill(agent: Agent) -> str:
    claude_tools = "\nallowed-tools: Bash(second-opinion *)" if agent.key == "claude" else ""
    return dedent(
        f"""\
        ---
        name: second-opinion
        description: Orchestrate parallel coding-agent worker teams, implementation tasks, reviews, and investigations through each provider's native harness with steerable task management.
        license: MIT
        compatibility: {agent.compatibility}{claude_tools}
        ---

        {MARKER}

        # Second Opinion

        Use this skill when the user or task benefits from one or many coding agents working as subagents: parallel implementation, tests, investigation, code review, debugging, documentation, or narrowly assigned patches. Second Opinion is a worker-pool orchestrator, not only a review tool.

        Second Opinion is model agnostic. Treat Codex, Claude Code, OpenCode, Grok Build, and Google Antigravity as user-configured agent surfaces, not fixed model choices. Pick a target because its workflow, tools, context window, provider setup, or strongest capabilities fit the task. Use `--model` only when the user asks for a specific model or when a target CLI requires a model override.

        ## Native Image Creation

        When a visual concept would help a design or implementation task, discover image-generation tools already available inside the coding harnesses, then create a real raster artifact through that harness's native tool:

        ```bash
        second-opinion image-tools --available --json
        second-opinion image auto --from {agent.key} --cwd "$PWD" --output design/concept.png --reference current-ui.png --background --manager none -- "Overhaul this interface into a deliberate product design."
        ```

        `image` does not call an image API itself, install a tool, or handle an image API key. It asks an image-capable coding harness to use its existing authenticated native tool, attaches references through native CLI flags where supported, and fails if the requested raster artifact is missing or invalid. Codex's built-in `imagegen` / `image_gen` path is detected automatically. If another harness exposes an image tool that cannot be detected from a skill, declare it for routing with `SECOND_OPINION_IMAGE_TOOLS=claude=tool-name` or select that harness explicitly. `image-tools --json` includes provider-native generator choices; declare names a harness exposes with `SECOND_OPINION_IMAGE_MODELS='claude=model-a|model-b'` when static discovery cannot list them.

        Treat the generated artifact as design input, not finished implementation. Inspect it, then give its path and the original product constraints to the best implementation worker—for example, pass a generated concept to an Opus-class Claude worker for a frontend overhaul. Use `--image-model` only when the user requests a particular generator that the native tool already exposes; `--model` selects the coding-harness model supervising the image task.

        ## Parallel Worker Teams

        When several independent slices can run at once, use `second-opinion team`. It creates genuinely parallel tasks, one native harness process and fresh context per worker. The calling model remains the orchestrator: keep working, steer individual workers in the manager, then synthesize and verify their results.

        ```bash
        second-opinion team codex --from {agent.key} --count 5 --strategy balanced --model gpt-5.6-luna --reasoning xhigh --cwd "$PWD" -- "Implement the feature, tests, reviews, and integration work in parallel."
        second-opinion team claude --from {agent.key} --count 5 --strategy build --model claude-sonnet-5 --reasoning xhigh --cwd "$PWD" --manager none -- "Split this implementation into non-overlapping worker roles."
        second-opinion team grok --from {agent.key} --count 5 --strategy review --model grok-4.5 --reasoning high --cwd "$PWD" --manager terminal -- "Review the system from five distinct angles."
        ```

        `--strategy build` assigns implementation-oriented roles, `review` assigns independent read-only lenses, and `balanced` mixes work and review. Repeat `--role` for custom assignments. Use `--mode work` or `--mode consult` only when every worker should share one mode. Model names pass through to the selected harness; do not assume a name is available without checking that provider.

        Every worker receives a team id, index, role, collision-avoidance rules, and shared objective. Do not launch overlapping work roles on the same files. Prefer explicit custom roles when the repository cannot be divided safely. Collect a whole pool with `second-opinion wait TEAM_ID`, or steer its individual job ids in the native app or terminal manager.

        ## Keyless Benchmark Tool

        When model or harness choice materially affects capability, latency, or budget, query Artificial Analysis before routing. This public-data tool needs no API key, has no sign-in step, caches results for six hours, and visibly attributes Artificial Analysis:

        ```bash
        second-opinion benchmarks --kind models --sort coding --max-cost 0.50 --limit 12 --json
        second-opinion benchmarks --kind models --sort agentic --min-intelligence 45 --json
        second-opinion benchmarks --kind agents --sort agent-score --max-cost 3 --json
        ```

        Model results include the Artificial Analysis Intelligence, Coding, and Agentic indices, average Intelligence Index cost/time per task, token prices, and speed when published. Agent results include the harness-specific Artificial Analysis Coding Agent Index, average cost/time per coding task, steps, and tokens. Treat scores as decision support, not a guarantee; also account for installed CLIs, user access, task fit, and exact harness model ids. Use `--refresh` for a fresh public-page fetch or `--offline` after the first cached fetch.

        ## Workflow

        1. Run `second-opinion status --json` to see which agent CLIs and skill files are available. If routing cost or capability is uncertain, use the keyless `second-opinion benchmarks ... --json` tool above.
        2. Think through whether a second perspective is useful: architecture uncertainty, risky patches, security review, broad exploration, provider/model-specific behavior, or a narrow implementation slice. If it is not useful, continue directly.
        3. Choose a target that is not `{agent.key}` unless the user explicitly asks for a same-agent fresh-context pass or no other agent is available.
        4. Start subagents in the background so you and the subagent can work at the same time. The CLI default mode is `work`, which may edit files. Use explicit `--mode consult` for read-only review, planning, or risk analysis:

           ```bash
           second-opinion ask auto --from {agent.key} --cwd "$PWD" --mode consult --background -- "Review the current approach and call out risks."
           ```

           Background tasks open the lightweight native task manager by default. Honor a user's preference with `--manager terminal` for a separate terminal manager or `--manager none`/`--no-window` for no window. `SECOND_OPINION_MANAGER=app|terminal|none` can set the default without changing any coding-agent app.

        5. For planning-heavy tasks, it is valid to ask one target in consult mode to theorize which agent/model surface should handle which scenarios. A parent-managed `second-opinion team` is encouraged when parallel slices are useful; workers must not recursively spawn more Second Opinion workers unless the user explicitly requests a deeper chain.

        6. Continue your own non-overlapping work after the background job starts. Later, collect the subagent result:

           ```bash
           second-opinion jobs
           second-opinion wait JOB_ID
           ```

           The user can also run `second-opinion app` or `second-opinion tui` to inspect every Second Opinion task, send steering messages, change the model for future turns, stop/retry tasks, and archive completed work. Follow-up turns continue through the same target's native CLI harness.

        7. Work mode is the default. Use it for narrow implementation slices, and assign non-overlapping files:

           ```bash
           second-opinion ask {example_work_target(agent)} --from {agent.key} --cwd "$PWD" --background -- "Implement the parser tests only. Do not touch the API layer."
           ```

        8. Do not wait immediately unless the subagent's answer blocks your next step. When you do collect the result, inspect its output, verify any file changes, and integrate it deliberately.

        ## Optional Goal Mode

        Do not use goal mode by default. It is not normally recommended for routine second-opinion calls.

        Use `--goal` only when the user explicitly asks to use Second Opinion with goals, or when the user has clearly requested a long-running delegated goal. Goal mode is useful when the parent agent wants another agent to keep a bounded objective active while the parent continues coordinating. For targets with a known native goal command, Second Opinion includes that target's `/goal ...` command in the subagent prompt.

        ```bash
        second-opinion ask auto --from {agent.key} --cwd "$PWD" --mode work --background --goal "Finish the migration tests and report blockers." -- "Work toward this goal in the assigned files only."
        ```

        When you start a goal-backed subagent, the goal remains your responsibility as the parent agent. Record the returned job id, check `second-opinion jobs`, collect it with `second-opinion wait JOB_ID`, verify the output and any edits, and do not report the overall user task as finished while that delegated goal is still running or unresolved.

        ## Target Selection

        {render_target_notes()}

        Practical routing tips:

        {render_routing_tips()}

        `auto` uses these hints and excludes the calling agent when possible. Use an explicit target when the user asks for a specific agent. Prefer capability fit over model branding.

        ## Guardrails

        - Do not ask the subagent to use Second Opinion again unless the user explicitly wants a deeper agent chain.
        - Do not assign two agents to edit the same files at the same time.
        - Do not pass secrets, API keys, private tokens, or unrelated personal data in the task text.
        - If the subagent command fails because the target CLI is missing or unauthenticated, report that directly and continue with your own best effort.
        - Claude Code delegation uses its documented non-interactive print mode through `claude -p`.
        - Second Opinion only installs skill files and this CLI. It does not change model settings, agent permissions, hooks, MCP servers, or provider credentials.
        - The optional native/terminal task managers are separate processes. They do not edit or embed themselves into Codex, Claude Code, or another coding-agent app.
        - Keep delegation model-neutral unless the user explicitly names a model. The target agent's own CLI and user settings decide the default model.
        - Do not use `--goal` unless the user explicitly wants goal-backed delegation. If you do use it, track and resolve the goal before you finish.
        """
    )


def managed_write(path: Path, content: str, *, force: bool, dry_run: bool) -> str:
    if path.exists():
        existing = path.read_text(encoding="utf-8", errors="replace")
        if MARKER not in existing and not force:
            return "skipped-existing"
    if dry_run:
        return "would-write"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")
    return "installed"


def install_agents(keys: Iterable[str], *, force: bool = False, dry_run: bool = False) -> int:
    rc = 0
    for key in keys:
        agent = resolve_agent(key)
        path = agent_skill_file(agent)
        status = managed_write(path, render_skill(agent), force=force, dry_run=dry_run)
        label = f"{agent.display:<12}"
        if status == "installed":
            print(f"{style('installed', 'green')} {label} {path}")
        elif status == "would-write":
            print(f"{style('dry-run', 'yellow')}   {label} {path}")
        elif status == "skipped-existing":
            print(f"{style('skipped', 'yellow')}   {label} {path}")
            print("             existing file is not managed by Second Opinion; use --force to replace it")
            rc = 1
    return rc


def uninstall_agents(keys: Iterable[str], *, dry_run: bool = False) -> int:
    rc = 0
    for key in keys:
        agent = resolve_agent(key)
        path = agent_skill_file(agent)
        label = f"{agent.display:<12}"
        if not path.exists():
            print(f"{style('missing', 'dim')}   {label} {path}")
            continue
        existing = path.read_text(encoding="utf-8", errors="replace")
        if MARKER not in existing:
            print(f"{style('skipped', 'yellow')}   {label} {path}")
            print("             file is not managed by Second Opinion; remove it manually if intended")
            rc = 1
            continue
        if dry_run:
            print(f"{style('dry-run', 'yellow')}   {label} remove {path}")
        else:
            path.unlink()
            try:
                path.parent.rmdir()
            except OSError:
                pass
            print(f"{style('removed', 'green')}   {label} {path}")
    return rc


def default_install_targets() -> list[str]:
    detected = detect_agents()
    targets = [key for key, info in detected.items() if info["detected"]]
    return targets or list(AGENTS)


def interactive_targets() -> list[str]:
    detected = detect_agents()
    print_banner()
    print("Detected agents:")
    for index, (key, info) in enumerate(detected.items(), start=1):
        status = "found" if info["detected"] else "not found"
        status_color = "green" if info["detected"] else "yellow"
        installed = "skill installed" if info["skill_installed"] else "skill missing"
        print(f"  {index}. {info['name']:<12} {style(status, status_color):<16} {installed}")
    print()
    defaults = default_install_targets()
    default_text = ", ".join(defaults)
    print(f"Default: install skills for {default_text}")
    answer = input("Install default set? [Y/n/custom] ").strip().lower()
    if answer in ("", "y", "yes"):
        return defaults
    if answer in ("n", "no"):
        return []
    selected = answer.replace("custom", "").strip()
    if not selected:
        selected = input("Agents to install (comma separated): ").strip()
    parts = [part.strip().lower() for part in selected.replace(" ", ",").split(",") if part.strip()]
    if "all" in parts:
        return list(AGENTS)
    return [resolve_agent(part).key for part in parts]


def choose_target(caller: str | None, task: str, include_self: bool = False) -> Agent:
    detected = detect_agents()
    available = [key for key, info in detected.items() if info["detected"]]
    if not available:
        raise SystemExit("No supported agent CLI was found on PATH. Run `second-opinion status` for details.")

    caller_key = resolve_agent(caller).key if caller else None
    candidates = [key for key in available if include_self or key != caller_key]
    if not candidates:
        candidates = available

    lowered = task.lower()
    scores = {key: 0 for key in candidates}
    for key in candidates:
        scores[key] += {"codex": 4, "claude": 4, "antigravity": 3, "grok": 3, "opencode": 2}.get(key, 0)

    review_terms = ("review", "audit", "risk", "security", "architecture", "edge case")
    ui_terms = ("ui", "frontend", "front end", "design", "visual", "layout", "css", "responsive", "mobile", "polish", "landing page", "component")
    backend_terms = ("backend", "api", "server", "database", "auth", "data flow", "endpoint")
    build_terms = ("implement", "fix", "patch", "refactor", "test", "typescript", "python")
    explore_terms = ("explore", "brainstorm", "compare", "research", "spike", "parallel")
    model_terms = ("model", "provider", "openrouter", "local model", "configured models")
    google_terms = ("google", "gemini", "antigravity", "vertex", "firebase", "cloud run")

    def has_term(terms: tuple[str, ...]) -> bool:
        return any(re.search(r"\bui\b", lowered) if term == "ui" else term in lowered for term in terms)

    if has_term(review_terms):
        scores["claude"] = scores.get("claude", 0) + 5
        scores["codex"] = scores.get("codex", 0) + 2
    if has_term(ui_terms):
        scores["claude"] = scores.get("claude", 0) + 7
        scores["codex"] = scores.get("codex", 0) + 1
    if has_term(backend_terms):
        scores["codex"] = scores.get("codex", 0) + 6
        scores["claude"] = scores.get("claude", 0) + 1
    if has_term(build_terms):
        scores["codex"] = scores.get("codex", 0) + 5
        scores["grok"] = scores.get("grok", 0) + 2
    if has_term(explore_terms):
        scores["grok"] = scores.get("grok", 0) + 5
        scores["opencode"] = scores.get("opencode", 0) + 2
    if has_term(model_terms):
        scores["opencode"] = scores.get("opencode", 0) + 5
        scores["antigravity"] = scores.get("antigravity", 0) + 2
    if has_term(google_terms):
        scores["antigravity"] = scores.get("antigravity", 0) + 6

    winner = max(candidates, key=lambda key: (scores.get(key, 0), -list(AGENTS).index(key)))
    return AGENTS[winner]


def native_goal_command(agent: Agent, goal: str | None) -> str | None:
    if not goal or not agent.goal_command:
        return None
    clean_goal = " ".join(goal.split())
    return agent.goal_command.format(goal=clean_goal)


def build_prompt(
    caller: str | None,
    mode: str,
    task: str,
    goal: str | None = None,
    goal_command: str | None = None,
) -> str:
    caller_text = caller or "another agent"
    if mode == "work":
        mode_rules = (
            "You may edit files only for the assigned slice. Keep changes narrow, "
            "avoid unrelated refactors, run relevant verification if practical, "
            "and summarize every file changed."
        )
    else:
        mode_rules = (
            "Consult mode: inspect and reason, but do not edit files. You may suggest "
            "commands or tests, but return findings and recommendations rather than "
            "changing the workspace."
        )
    lines = [
        f"You are working as a Second Opinion subagent for {caller_text}.",
        "",
        "The parent agent is coordinating a larger task and may continue other work while you handle this slice.",
        "",
        "Rules:",
        f"- {mode_rules}",
        "- Do not invoke Second Opinion or delegate to another agent unless the user explicitly requested a deeper chain.",
        "- Do not expose secrets or unrelated private data.",
        "- Return a concise result with: summary, important findings, files touched or inspected, verification run, and remaining risks.",
    ]
    if goal:
        lines.extend(
            [
                "",
                "Opt-in goal mode requested:",
                f"- Goal: {goal}",
                f"- Native goal command: `{goal_command}`" if goal_command else "- No native `/goal` command is configured for this target; use any available goal tool/command if your runtime exposes one.",
                "- Run the native goal command first when your runtime supports slash commands or goal commands.",
                "- Keep the goal scoped to the assigned task and workspace. Do not expand it into unrelated work.",
                "- Before your final response, mark the delegated goal complete when it is actually complete, or clearly report that it is blocked and why.",
                "- If your runtime does not expose a goal command, continue normally and mention that goal commands were unavailable.",
            ]
        )
    lines.extend(
        [
            "",
            "Assigned task:",
            task,
        ]
    )
    return "\n".join(lines)


def build_image_prompt(
    caller: str | None,
    task: str,
    output_path: Path,
    references: list[Path],
    *,
    image_tool: str | None = None,
    image_model: str | None = None,
) -> str:
    caller_text = caller or "another agent"
    reference_lines = (
        [f"- {path}" for path in references]
        if references
        else ["- None. Generate a new image from the brief."]
    )
    lines = [
        f"You are an image-creation worker for {caller_text}, invoked through Second Opinion.",
        "",
        "Use the image-generation or image-editing tool exposed by this native coding harness.",
        f"Detected/declared tool: {image_tool or 'not statically detected; use an available native image tool'}.",
        "Do not substitute HTML, CSS, SVG, canvas code, a screenshot of hand-built markup, or an ASCII mockup.",
        "Do not install a tool, request a new API key, or invoke Second Opinion recursively.",
        "If this harness has no usable native image tool, stop and report that clearly without creating a placeholder.",
        "",
        "Artifact contract:",
        f"- Save or copy the final raster image to exactly: {output_path}",
        "- The final file must be a valid, non-empty PNG, JPEG, WebP, or GIF matching its extension.",
        "- Inspect every reference image with the harness's image-viewing capability before generating or editing.",
        "- Keep all unrelated workspace files unchanged.",
        "- Before finishing, inspect the generated artifact and make one focused correction if it misses the brief.",
        f"- End with `SECOND_OPINION_IMAGE: {output_path}` so the orchestrator can locate the artifact.",
    ]
    if image_model:
        lines.extend(
            [
                f"- Requested native image model: {image_model}",
                "- Use that model only if the native tool exposes it through existing authentication; otherwise report the limitation.",
            ]
        )
    lines.extend(["", "Reference images:", *reference_lines, "", "Creative brief:", task])
    return "\n".join(lines)


def artifact_fingerprint(path: Path) -> tuple[int, int] | None:
    try:
        stat = path.stat()
    except OSError:
        return None
    return stat.st_size, stat.st_mtime_ns


def validate_image_artifact(path: Path, before: tuple[int, int] | None = None) -> str | None:
    if not path.is_file():
        return f"Image harness finished without creating the required artifact: {path}"
    current = artifact_fingerprint(path)
    if not current or current[0] == 0:
        return f"Image harness created an empty artifact: {path}"
    if before is not None and current == before:
        return f"Image harness did not update the required artifact: {path}"
    try:
        with path.open("rb") as image_file:
            header = image_file.read(16)
    except OSError as error:
        return f"Could not inspect image artifact {path}: {error}"
    suffix = path.suffix.lower()
    valid = {
        ".png": header.startswith(b"\x89PNG\r\n\x1a\n"),
        ".jpg": header.startswith(b"\xff\xd8\xff"),
        ".jpeg": header.startswith(b"\xff\xd8\xff"),
        ".webp": header.startswith(b"RIFF") and header[8:12] == b"WEBP",
        ".gif": header.startswith((b"GIF87a", b"GIF89a")),
    }.get(suffix, False)
    if not valid:
        return f"Image harness output is not a valid {suffix or 'raster image'} file: {path}"
    return None


def normalize_model_for_agent(agent: Agent, model: str | None) -> str | None:
    if not model:
        return None
    if agent.key == "claude":
        return re.sub(r"(?<=\d)\.(?=\d)", "-", model)
    return model


def command_for_agent(
    agent: Agent,
    *,
    cwd: Path,
    mode: str,
    prompt: str,
    model: str | None,
    trust: bool,
    reasoning: str | None = None,
    attachments: Iterable[Path] = (),
) -> list[str]:
    exe = shutil.which(agent.command) or agent.command
    model = normalize_model_for_agent(agent, model)
    attachment_paths = [Path(path).expanduser().resolve() for path in attachments]
    if agent.key == "codex":
        args = list(agent.work_args if mode == "work" else agent.consult_args)
        cmd = [exe, *args, "--cd", str(cwd)]
        for path in attachment_paths:
            cmd.extend(["--image", str(path)])
        if model:
            cmd.extend(["--model", model])
        if reasoning:
            cmd.extend(["--config", f"model_reasoning_effort={reasoning}"])
        cmd.append(prompt)
        return cmd

    if agent.key == "claude":
        claude_args = list(agent.work_args if mode == "work" else agent.consult_args)
        cmd = [exe, "-p", *claude_args]
        for directory in dict.fromkeys(str(path.parent) for path in attachment_paths):
            cmd.extend(["--add-dir", directory])
        if model:
            cmd.extend(["--model", model])
        if reasoning:
            cmd.extend(["--effort", reasoning])
        cmd.append(prompt)
        return cmd

    if agent.key == "opencode":
        args = list(agent.work_args if mode == "work" else agent.consult_args)
        cmd = [exe, *args, "--dir", str(cwd)]
        for path in attachment_paths:
            cmd.extend(["--file", str(path)])
        if model:
            cmd.extend(["--model", model])
        if reasoning:
            cmd.extend(["--variant", reasoning])
        if mode == "work" and trust:
            cmd.append("--dangerously-skip-permissions")
        cmd.append(prompt)
        return cmd

    if agent.key == "grok":
        cmd = [exe, "--no-auto-update", "--cwd", str(cwd), "--output-format", "plain"]
        if model:
            cmd.extend(["--model", model])
        if reasoning:
            cmd.extend(["--reasoning-effort", reasoning])
        if mode == "work" and trust:
            cmd.append("--always-approve")
        cmd.extend(["-p", prompt])
        return cmd

    if agent.key == "antigravity":
        args = list(agent.work_args if mode == "work" else agent.consult_args)
        cmd = [exe]
        if args and args[0] == "--print":
            cmd.extend(["--print", prompt, *args[1:]])
        else:
            cmd.extend([*args, prompt])
        if model:
            cmd.extend(["--model", model])
        if reasoning:
            cmd.extend(["--effort", reasoning])
        for directory in dict.fromkeys(str(path.parent) for path in attachment_paths):
            cmd.extend(["--add-dir", directory])
        if mode == "work" and trust:
            cmd.append("--dangerously-skip-permissions")
        return cmd

    raise AssertionError(f"Unhandled agent {agent.key}")


def team_assignments(
    strategy: str,
    count: int,
    custom_roles: list[str] | None = None,
    forced_mode: str | None = None,
) -> list[tuple[str, str, str]]:
    if count < 1 or count > 32:
        raise SystemExit("Team size must be between 1 and 32 workers.")
    if custom_roles:
        base = tuple((role.strip(), "work", role.strip()) for role in custom_roles if role.strip())
        if not base:
            raise SystemExit("Provide at least one non-empty --role.")
    else:
        base = TEAM_STRATEGIES[strategy]
    result: list[tuple[str, str, str]] = []
    for index in range(count):
        role, default_mode, instruction = base[index % len(base)]
        pass_number = index // len(base) + 1
        if pass_number > 1:
            role = f"{role} · pass {pass_number}"
            instruction += " Take a fresh approach and look specifically for work the earlier pass may miss."
        result.append((role, forced_mode or default_mode, instruction))
    return result


def build_team_task(
    task: str,
    *,
    team_id: str,
    role: str,
    instruction: str,
    worker_index: int,
    worker_count: int,
) -> str:
    return dedent(
        f"""\
        Parallel team: {team_id}
        Worker: {worker_index} of {worker_count}
        Specialized role: {role}

        Role assignment:
        {instruction}

        Shared objective:
        {task}

        Coordination rules:
        - The parent agent is the orchestrator and will synthesize all worker results.
        - Work only inside your assigned role. Do not take over another worker's slice.
        - Other workers may update the workspace concurrently. Re-read files immediately before editing and preserve their changes.
        - Never reset, discard, or overwrite changes you did not create.
        - Report concrete work and findings so the orchestrator can integrate them.
        """
    ).strip()


def task_from_parts(parts: list[str], explicit_task: str | None) -> str:
    if explicit_task:
        return explicit_task.strip()
    cleaned = list(parts)
    if cleaned and cleaned[0] == "--":
        cleaned = cleaned[1:]
    return " ".join(cleaned).strip()


def jobs_dir() -> Path:
    return home_dir() / ".second-opinion" / "jobs"


def job_paths(job_id: str) -> tuple[Path, Path]:
    root = jobs_dir()
    return root / f"{job_id}.json", root / f"{job_id}.log"


def timestamp() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%S%z")


def atomic_write_json(path: Path, payload: dict[str, object]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp", dir=str(path.parent))
    temp_path = Path(temp_name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, indent=2)
            handle.write("\n")
        os.replace(temp_path, path)
    finally:
        try:
            temp_path.unlink()
        except FileNotFoundError:
            pass


@contextmanager
def job_file_lock(job_id: str):
    """Serialize metadata edits between the manager and detached workers."""
    root = jobs_dir()
    root.mkdir(parents=True, exist_ok=True)
    lock_path = root / f"{job_id}.lock"
    with lock_path.open("a+b") as handle:
        handle.seek(0, os.SEEK_END)
        if handle.tell() == 0:
            handle.write(b"0")
            handle.flush()
        handle.seek(0)
        if os.name == "nt":
            import msvcrt

            msvcrt.locking(handle.fileno(), msvcrt.LK_LOCK, 1)
        else:
            import fcntl

            fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            handle.seek(0)
            if os.name == "nt":
                import msvcrt

                msvcrt.locking(handle.fileno(), msvcrt.LK_UNLCK, 1)
            else:
                import fcntl

                fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def update_job(job_id: str, change: Callable[[dict[str, object]], None]) -> dict[str, object]:
    meta_path, _ = job_paths(job_id)
    with job_file_lock(job_id):
        if not meta_path.exists():
            raise SystemExit(f"Unknown Second Opinion job: {job_id}")
        job = json.loads(meta_path.read_text(encoding="utf-8"))
        change(job)
        job["updated_at"] = timestamp()
        atomic_write_json(meta_path, job)
    return job


def is_windows_process_running(pid: int) -> bool:
    """Probe a Windows process without sending console events or signals."""
    import ctypes
    from ctypes import wintypes

    kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
    kernel32.OpenProcess.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.DWORD]
    kernel32.OpenProcess.restype = wintypes.HANDLE
    kernel32.WaitForSingleObject.argtypes = [wintypes.HANDLE, wintypes.DWORD]
    kernel32.WaitForSingleObject.restype = wintypes.DWORD
    kernel32.CloseHandle.argtypes = [wintypes.HANDLE]
    kernel32.CloseHandle.restype = wintypes.BOOL

    # SYNCHRONIZE is sufficient to check whether the process has exited.
    handle = kernel32.OpenProcess(0x00100000, False, pid)
    if not handle:
        error = ctypes.get_last_error()
        if error == 87:  # ERROR_INVALID_PARAMETER: no such PID.
            return False
        if error == 5:  # ERROR_ACCESS_DENIED: assume alive, as on POSIX.
            return True
        raise ctypes.WinError(error)
    try:
        result = kernel32.WaitForSingleObject(handle, 0)
        if result == 0:  # WAIT_OBJECT_0: process has exited.
            return False
        if result == 258:  # WAIT_TIMEOUT: process is still running.
            return True
        raise ctypes.WinError(ctypes.get_last_error())
    finally:
        kernel32.CloseHandle(handle)


def is_process_running(pid: int) -> bool:
    if pid <= 0:
        return False
    if os.name == "nt":
        # Avoid wrapping malformed metadata into an unrelated DWORD PID.
        if pid > 0xFFFFFFFF:
            return False
        return is_windows_process_running(pid)
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def read_job(job_id: str) -> dict[str, object]:
    meta_path, _ = job_paths(job_id)
    if not meta_path.exists():
        raise SystemExit(f"Unknown Second Opinion job: {job_id}")
    try:
        return json.loads(meta_path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as error:
        raise SystemExit(f"Second Opinion job metadata is invalid: {job_id}") from error


def job_status(job: dict[str, object]) -> str:
    raw_pid = job.get("worker_pid", job.get("pid"))
    if raw_pid:
        try:
            if is_process_running(int(raw_pid)):
                return "running"
        except (TypeError, ValueError):
            pass
    state = str(job.get("state", "finished"))
    if state == "launching":
        return "running"
    turns = job.get("turns", [])
    if isinstance(turns, list) and any(
        isinstance(turn, dict) and turn.get("status") == "queued" for turn in turns
    ):
        return "queued"
    if state in {"failed", "stopped", "finished"}:
        return state
    return "finished"


def process_group_options(*, detach_console: bool = False) -> dict[str, object]:
    if os.name == "nt":
        flags = subprocess.CREATE_NEW_PROCESS_GROUP
        if detach_console:
            flags |= subprocess.DETACHED_PROCESS
        return {"creationflags": flags}
    return {"start_new_session": True}


def script_path() -> Path:
    return Path(__file__).resolve()


def spawn_job_worker(job_id: str) -> int:
    update_job(job_id, lambda job: job.update({"state": "launching"}))
    try:
        process = subprocess.Popen(
            [sys.executable, str(script_path()), "_run-job", job_id],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            close_fds=True,
            **process_group_options(detach_console=True),
        )
    except OSError:
        update_job(job_id, lambda job: job.update({"state": "failed"}))
        raise
    track_detached_process(process)
    return process.pid


def create_background_job(
    agent: Agent,
    mode: str,
    cmd: list[str],
    cwd: Path,
    task: str,
    *,
    goal: str | None = None,
    caller: str | None = None,
    model: str | None = None,
    reasoning: str | None = None,
    trust: bool = False,
    prompt: str | None = None,
    team_id: str | None = None,
    team_name: str | None = None,
    role: str | None = None,
    worker_index: int | None = None,
    worker_count: int | None = None,
    job_kind: str = "agent",
    artifact_path: Path | None = None,
    reference_paths: Iterable[Path] = (),
) -> tuple[str, int]:
    root = jobs_dir()
    root.mkdir(parents=True, exist_ok=True)
    job_id = time.strftime("%Y%m%d-%H%M%S") + f"-{os.getpid()}-{agent.key}-{uuid.uuid4().hex[:6]}"
    meta_path, log_path = job_paths(job_id)
    started_at = timestamp()
    turn_id = uuid.uuid4().hex
    metadata: dict[str, object] = {
        "schema_version": 2,
        "id": job_id,
        "pid": None,
        "worker_pid": None,
        "agent": agent.key,
        "agent_name": agent.display,
        "mode": mode,
        "cwd": str(cwd),
        "log_path": str(log_path),
        "started_at": started_at,
        "updated_at": started_at,
        "task": task,
        "goal": goal,
        "caller": caller,
        "model": model,
        "reasoning": reasoning,
        "team_id": team_id,
        "team_name": team_name,
        "role": role,
        "worker_index": worker_index,
        "worker_count": worker_count,
        "kind": job_kind,
        "artifact_path": str(artifact_path) if artifact_path else None,
        "reference_paths": [str(path) for path in reference_paths],
        "trust": trust,
        "archived": False,
        "stop_requested": False,
        "state": "queued",
        "command": cmd,
        "turns": [
            {
                "id": turn_id,
                "kind": "initial",
                "message": task,
                "prompt": prompt,
                "model": model,
                "reasoning": reasoning,
                "command": cmd,
                "status": "queued",
                "created_at": started_at,
            }
        ],
    }
    atomic_write_json(meta_path, metadata)
    log_path.write_text("", encoding="utf-8")
    return job_id, spawn_job_worker(job_id)


def start_background_job(
    agent: Agent,
    mode: str,
    cmd: list[str],
    cwd: Path,
    task: str,
    goal: str | None = None,
    *,
    caller: str | None = None,
    model: str | None = None,
    reasoning: str | None = None,
    trust: bool = False,
    manager: str = "none",
    prompt: str | None = None,
) -> int:
    job_id, pid = create_background_job(
        agent,
        mode,
        cmd,
        cwd,
        task,
        goal=goal,
        caller=caller,
        model=model,
        reasoning=reasoning,
        trust=trust,
        prompt=prompt,
    )
    _, log_path = job_paths(job_id)

    print(style(f"Second Opinion -> {agent.display} ({mode}, background)", "cyan"))
    print(f"job: {job_id}")
    print(f"pid: {pid}")
    print(f"log: {log_path}")
    if goal:
        print(f"goal: {goal}")
        print("goal-note: parent agent must wait for this job and verify completion before finishing")
    print(f"next: second-opinion wait {job_id}")
    if manager != "none":
        opened, detail = open_manager(manager, job_id)
        label = "manager" if opened else "manager-warning"
        print(f"{label}: {detail}")
    return 0


def run_job_worker(job_id: str) -> int:
    """Run queued turns using their provider-specific commands."""
    worker_pid = os.getpid()

    def mark_worker(job: dict[str, object]) -> None:
        job["worker_pid"] = worker_pid
        job["pid"] = worker_pid
        if not job.get("stop_requested"):
            job["state"] = "running"

    update_job(job_id, mark_worker)
    final_rc = 0
    while True:
        job = read_job(job_id)
        if job.get("stop_requested"):
            break
        turns = job.get("turns", [])
        queued = next(
            (
                turn
                for turn in turns
                if isinstance(turn, dict) and turn.get("status") == "queued"
            ),
            None,
        )
        if queued is None:
            break
        turn_id = str(queued["id"])
        cmd = [str(part) for part in queued.get("command", [])]
        if not cmd:
            final_rc = 1

            def mark_missing(job_data: dict[str, object]) -> None:
                for turn in job_data.get("turns", []):
                    if isinstance(turn, dict) and turn.get("id") == turn_id:
                        turn["status"] = "failed"
                        turn["returncode"] = 1
                        turn["finished_at"] = timestamp()
                job_data["state"] = "failed"

            update_job(job_id, mark_missing)
            break

        def mark_turn_running(job_data: dict[str, object]) -> None:
            for turn in job_data.get("turns", []):
                if isinstance(turn, dict) and turn.get("id") == turn_id:
                    turn["status"] = "running"
                    turn["started_at"] = timestamp()
            job_data["state"] = "running"

        update_job(job_id, mark_turn_running)
        current = read_job(job_id)
        log_path = Path(str(current["log_path"]))
        artifact_path = (
            Path(str(current["artifact_path"]))
            if current.get("kind") == "image" and current.get("artifact_path")
            else None
        )
        artifact_before = artifact_fingerprint(artifact_path) if artifact_path else None
        turn_number = sum(
            1
            for turn in current.get("turns", [])
            if isinstance(turn, dict) and turn.get("status") != "queued"
        )
        with log_path.open("a", encoding="utf-8") as log_file:
            log_file.write(f"\n{'=' * 72}\n")
            log_file.write(
                f"Turn {turn_number} · {current.get('agent_name')} · {current.get('mode')}\n"
            )
            log_file.write(f"started_at: {timestamp()}\n")
            log_file.write(f"cwd: {current.get('cwd')}\n")
            if queued.get("model"):
                log_file.write(f"model: {queued.get('model')}\n")
            if queued.get("reasoning"):
                log_file.write(f"reasoning: {queued.get('reasoning')}\n")
            log_file.write(f"message: {queued.get('message', '')}\n")
            log_file.write(f"harness: {cmd[0]} ({len(cmd) - 1} arguments)\n")
            log_file.write(f"{'-' * 72}\n\n")
            log_file.flush()
            try:
                completed = subprocess.run(
                    cmd,
                    cwd=str(current["cwd"]),
                    stdin=subprocess.DEVNULL,
                    stdout=log_file,
                    stderr=subprocess.STDOUT,
                    text=True,
                    check=False,
                )
                final_rc = completed.returncode
                if final_rc == 0 and artifact_path:
                    artifact_error = validate_image_artifact(artifact_path, artifact_before)
                    if artifact_error:
                        log_file.write(f"\nSecond Opinion artifact check failed: {artifact_error}\n")
                        final_rc = 1
                    else:
                        log_file.write(f"\nSECOND_OPINION_IMAGE: {artifact_path}\n")
            except OSError as error:
                log_file.write(f"\nSecond Opinion could not start the agent harness: {error}\n")
                final_rc = 127

        def finish_turn(job_data: dict[str, object]) -> None:
            stopped = bool(job_data.get("stop_requested"))
            for turn in job_data.get("turns", []):
                if isinstance(turn, dict) and turn.get("id") == turn_id:
                    turn["status"] = "stopped" if stopped else ("finished" if final_rc == 0 else "failed")
                    turn["returncode"] = final_rc
                    turn["finished_at"] = timestamp()
            if stopped:
                job_data["state"] = "stopped"
            else:
                has_queue = any(
                    isinstance(turn, dict) and turn.get("status") == "queued"
                    for turn in job_data.get("turns", [])
                )
                job_data["state"] = "queued" if has_queue else ("finished" if final_rc == 0 else "failed")

        update_job(job_id, finish_turn)

    def finish_worker(job: dict[str, object]) -> None:
        if job.get("worker_pid") == worker_pid:
            job["worker_pid"] = None
        if job.get("pid") == worker_pid:
            job["pid"] = None
        if job.get("stop_requested"):
            job["state"] = "stopped"

    update_job(job_id, finish_worker)
    return final_rc


def list_jobs(*, include_archived: bool = True) -> list[dict[str, object]]:
    root = jobs_dir()
    result: list[dict[str, object]] = []
    if not root.exists():
        return result
    for meta_path in sorted(root.glob("*.json"), reverse=True):
        try:
            job = json.loads(meta_path.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError):
            continue
        if not include_archived and job.get("archived"):
            continue
        job["status"] = job_status(job)
        result.append(job)
    return result


def log_tail(job: dict[str, object], limit: int = 120_000) -> str:
    path = Path(str(job.get("log_path", "")))
    if not path.exists():
        return ""
    try:
        with path.open("rb") as handle:
            size = path.stat().st_size
            handle.seek(max(0, size - limit))
            data = handle.read()
        text = data.decode("utf-8", errors="replace")
        return ("… earlier output omitted …\n" if size > limit else "") + text
    except OSError:
        return ""


MarkdownRun = tuple[str, tuple[str, ...], str | None]
ANSI_ESCAPE_RE = re.compile(r"\x1b(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])")
MARKDOWN_LINK_RE = re.compile(
    r"(!?)\[([^\]\n]+)\]\(<?([^\s)>]+)>?(?:\s+['\"][^'\"]*['\"])?\)"
)
MARKDOWN_AUTOLINK_RE = re.compile(r"<((?:https?://|mailto:)[^>\s]+)>")
MARKDOWN_TABLE_RULE_RE = re.compile(r":?-{3,}:?")


def safe_markdown_link(target: str) -> str | None:
    """Return a user-clickable web link while rejecting executable URI schemes."""
    clean = target.strip()
    try:
        scheme = urllib.parse.urlparse(clean).scheme.lower()
    except ValueError:
        return None
    return clean if scheme in {"http", "https", "mailto"} else None


def markdown_table_cells(line: str) -> list[str]:
    stripped = line.strip()
    if "|" not in stripped:
        return []
    if stripped.startswith("|"):
        stripped = stripped[1:]
    if stripped.endswith("|"):
        stripped = stripped[:-1]
    cells = [cell.strip() for cell in stripped.split("|")]
    return cells if len(cells) >= 2 else []


def markdown_runs(content: str) -> list[MarkdownRun]:
    """Parse common Markdown into lightweight semantic runs for a Tk Text widget."""
    runs: list[MarkdownRun] = []

    def emit(text: str, tags: tuple[str, ...] = (), link: str | None = None) -> None:
        if not text:
            return
        if runs and runs[-1][1] == tags and runs[-1][2] == link:
            previous, _, _ = runs[-1]
            runs[-1] = (previous + text, tags, link)
        else:
            runs.append((text, tags, link))

    def with_tag(tags: tuple[str, ...], tag: str) -> tuple[str, ...]:
        return tags if tag in tags else tags + (tag,)

    def inline(text: str, tags: tuple[str, ...] = (), depth: int = 0) -> None:
        if depth >= 8:
            emit(text, tags)
            return
        index = 0
        literal_start = 0

        def flush(end: int) -> None:
            nonlocal literal_start
            emit(text[literal_start:end], tags)

        while index < len(text):
            if text[index] == "\\" and index + 1 < len(text) and text[index + 1] in r"\\`*_{}[]()#+-.!~":
                flush(index)
                emit(text[index + 1], tags)
                index += 2
                literal_start = index
                continue

            if text[index] == "`":
                tick_count = 1
                while index + tick_count < len(text) and text[index + tick_count] == "`":
                    tick_count += 1
                delimiter = "`" * tick_count
                close = text.find(delimiter, index + tick_count)
                if close >= 0:
                    flush(index)
                    code = text[index + tick_count : close]
                    if code.startswith(" ") and code.endswith(" ") and len(code) > 2:
                        code = code[1:-1]
                    emit(code, with_tag(tags, "inline_code"))
                    index = close + tick_count
                    literal_start = index
                    continue

            link_match = MARKDOWN_LINK_RE.match(text, index)
            if link_match:
                flush(index)
                is_image, label, target = link_match.groups()
                label_text = f"Image: {label}" if is_image else label
                clean_target = safe_markdown_link(target)
                emit(label_text, with_tag(tags, "link") if clean_target else tags, clean_target)
                index = link_match.end()
                literal_start = index
                continue

            autolink_match = MARKDOWN_AUTOLINK_RE.match(text, index)
            if autolink_match:
                flush(index)
                target = autolink_match.group(1)
                emit(target, with_tag(tags, "link"), target)
                index = autolink_match.end()
                literal_start = index
                continue

            matched = False
            for delimiter, tag in (("**", "bold"), ("__", "bold"), ("~~", "strikethrough")):
                if not text.startswith(delimiter, index):
                    continue
                close = text.find(delimiter, index + len(delimiter))
                if close > index + len(delimiter):
                    flush(index)
                    inline(
                        text[index + len(delimiter) : close],
                        with_tag(tags, tag),
                        depth + 1,
                    )
                    index = close + len(delimiter)
                    literal_start = index
                    matched = True
                    break
            if matched:
                continue

            if text[index] in {"*", "_"}:
                delimiter = text[index]
                close = text.find(delimiter, index + 1)
                inside_word = delimiter == "_" and (
                    (index > 0 and text[index - 1].isalnum())
                    or (close >= 0 and close + 1 < len(text) and text[close + 1].isalnum())
                )
                if close > index + 1 and not text[index + 1].isspace() and not inside_word:
                    flush(index)
                    inline(text[index + 1 : close], with_tag(tags, "italic"), depth + 1)
                    index = close + 1
                    literal_start = index
                    continue

            index += 1

        flush(len(text))

    clean = ANSI_ESCAPE_RE.sub("", content.replace("\r\n", "\n").replace("\r", "\n"))
    if not clean:
        return runs
    lines = clean.splitlines()
    trailing_newline = clean.endswith("\n")
    index = 0
    in_fence = False
    fence_character = ""
    fence_length = 0

    def finish_line(tags: tuple[str, ...] = ()) -> None:
        if index < len(lines) - 1 or trailing_newline:
            emit("\n", tags)

    while index < len(lines):
        line = lines[index]
        fence_match = re.match(r"^\s*(`{3,}|~{3,})(?:[^`]*)$", line)
        if in_fence:
            stripped = line.lstrip()
            if stripped.startswith(fence_character * fence_length):
                in_fence = False
            else:
                emit(line, ("code_block",))
                finish_line(("code_block",))
            index += 1
            continue
        if fence_match:
            fence = fence_match.group(1)
            in_fence = True
            fence_character = fence[0]
            fence_length = len(fence)
            index += 1
            continue

        header_cells = markdown_table_cells(line)
        rule_cells = markdown_table_cells(lines[index + 1]) if index + 1 < len(lines) else []
        if header_cells and len(rule_cells) == len(header_cells) and all(
            MARKDOWN_TABLE_RULE_RE.fullmatch(cell) for cell in rule_cells
        ):
            for cell_index, cell in enumerate(header_cells):
                if cell_index:
                    emit("  │  ", ("table", "table_header"))
                inline(cell, ("table", "table_header"))
            emit("\n", ("table",))
            emit("──┼──".join("─" * max(3, len(cell)) for cell in header_cells), ("table", "separator"))
            finish_line(("table",))
            index += 2
            while index < len(lines):
                cells = markdown_table_cells(lines[index])
                if len(cells) != len(header_cells):
                    break
                for cell_index, cell in enumerate(cells):
                    if cell_index:
                        emit("  │  ", ("table",))
                    inline(cell, ("table",))
                finish_line(("table",))
                index += 1
            continue

        heading = re.match(r"^\s*(#{1,6})\s+(.+?)\s*#*\s*$", line)
        if heading:
            level = min(len(heading.group(1)), 3)
            inline(heading.group(2), (f"heading{level}",))
            finish_line((f"heading{level}",))
            index += 1
            continue

        if re.fullmatch(r"\s*(?:-{3,}|\*{3,}|_{3,})\s*", line):
            emit("────────────────────────────────────────", ("separator",))
            finish_line(("separator",))
            index += 1
            continue

        quote = re.match(r"^(\s*)>\s?(.*)$", line)
        if quote:
            emit(f"{'  ' * (len(quote.group(1)) // 2)}│ ", ("quote",))
            inline(quote.group(2), ("quote",))
            finish_line(("quote",))
            index += 1
            continue

        bullet = re.match(r"^(\s*)[-+*]\s+(.*)$", line)
        if bullet:
            body = bullet.group(2)
            marker = "•"
            task_marker = re.match(r"^\[([ xX])\]\s+(.*)$", body)
            if task_marker:
                marker = "☑" if task_marker.group(1).lower() == "x" else "☐"
                body = task_marker.group(2)
            emit(f"{'   ' * (len(bullet.group(1)) // 2)}{marker} ", ("list",))
            inline(body, ("list",))
            finish_line(("list",))
            index += 1
            continue

        ordered = re.match(r"^(\s*)(\d+)[.)]\s+(.*)$", line)
        if ordered:
            emit(
                f"{'   ' * (len(ordered.group(1)) // 2)}{ordered.group(2)}. ",
                ("list",),
            )
            inline(ordered.group(3), ("list",))
            finish_line(("list",))
            index += 1
            continue

        inline(line)
        finish_line()
        index += 1

    return runs


def build_followup_prompt(job: dict[str, object], message: str) -> str:
    recent_output = log_tail(job, 16_000).strip()
    context = recent_output or "No prior output was captured."
    image_rules = ""
    if job.get("kind") == "image" and job.get("artifact_path"):
        image_rules = dedent(
            f"""\

            This remains an image-creation task. Use the same native image tool, inspect the current artifact,
            apply the requested change, and replace the raster artifact at exactly:
            {job.get('artifact_path')}
            End with `SECOND_OPINION_IMAGE: {job.get('artifact_path')}`. Do not substitute code or a placeholder.
            """
        )
    return dedent(
        f"""\
        You are continuing Second Opinion task {job.get('id')} through the {job.get('agent_name')} harness.

        Original task:
        {job.get('task', '')}

        Latest captured task output:
        ---
        {context}
        ---

        User steering message:
        {message}

        {image_rules}

        Continue the same scoped task. Treat the steering message as the newest instruction. Do not invoke Second Opinion recursively. Return a concise update with work completed, files touched or inspected, verification, and remaining risks.
        """
    )


def queue_job_message(job_id: str, message: str) -> dict[str, object]:
    clean_message = message.strip()
    if not clean_message:
        raise SystemExit("Provide a non-empty steering message.")
    job = read_job(job_id)
    if job.get("archived"):
        raise SystemExit("Unarchive the task before sending a message.")
    agent = resolve_agent(str(job["agent"]))
    cwd = Path(str(job["cwd"])).expanduser().resolve()
    mode = str(job.get("mode", "work"))
    model = str(job["model"]) if job.get("model") else None
    reasoning = str(job["reasoning"]) if job.get("reasoning") else None
    trust = bool(job.get("trust", False))
    attachments = [Path(str(path)) for path in (job.get("reference_paths") or [])]
    prompt = build_followup_prompt(job, clean_message)
    cmd = command_for_agent(
        agent,
        cwd=cwd,
        mode=mode,
        prompt=prompt,
        model=model,
        trust=trust,
        reasoning=reasoning,
        attachments=attachments,
    )
    turn = {
        "id": uuid.uuid4().hex,
        "kind": "steer",
        "message": clean_message,
        "prompt": prompt,
        "model": model,
        "reasoning": reasoning,
        "command": cmd,
        "status": "queued",
        "created_at": timestamp(),
    }

    def append_turn(job_data: dict[str, object]) -> None:
        turns = job_data.setdefault("turns", [])
        if not isinstance(turns, list):
            turns = []
            job_data["turns"] = turns
        turns.append(turn)
        job_data["stop_requested"] = False
        if job_status(job_data) != "running":
            job_data["state"] = "queued"

    updated = update_job(job_id, append_turn)
    if job_status(updated) != "running":
        spawn_job_worker(job_id)
        updated = read_job(job_id)
        updated["status"] = job_status(updated)
    return updated


def set_job_model(job_id: str, model: str | None) -> dict[str, object]:
    clean_model = model.strip() if model else None

    def change(job: dict[str, object]) -> None:
        job["model"] = clean_model or None
        try:
            agent = resolve_agent(str(job["agent"]))
            cwd = Path(str(job["cwd"])).expanduser().resolve()
            mode = str(job.get("mode", "work"))
            trust = bool(job.get("trust", False))
            reasoning = str(job["reasoning"]) if job.get("reasoning") else None
        except (KeyError, SystemExit):
            return
        for turn in job.get("turns", []):
            if not isinstance(turn, dict) or turn.get("status") != "queued" or not turn.get("prompt"):
                continue
            turn["model"] = clean_model or None
            turn["command"] = command_for_agent(
                agent,
                cwd=cwd,
                mode=mode,
                prompt=str(turn["prompt"]),
                model=clean_model,
                trust=trust,
                reasoning=reasoning,
                attachments=[Path(str(path)) for path in (job.get("reference_paths") or [])],
            )
            if turn.get("kind") == "initial":
                job["command"] = turn["command"]

    return update_job(job_id, change)


def set_job_reasoning(job_id: str, reasoning: str | None) -> dict[str, object]:
    clean_reasoning = reasoning.strip() if reasoning else None

    def change(job: dict[str, object]) -> None:
        job["reasoning"] = clean_reasoning or None
        try:
            agent = resolve_agent(str(job["agent"]))
            cwd = Path(str(job["cwd"])).expanduser().resolve()
            mode = str(job.get("mode", "work"))
            trust = bool(job.get("trust", False))
            model = str(job["model"]) if job.get("model") else None
        except (KeyError, SystemExit):
            return
        for turn in job.get("turns", []):
            if not isinstance(turn, dict) or turn.get("status") != "queued" or not turn.get("prompt"):
                continue
            turn["reasoning"] = clean_reasoning or None
            turn["command"] = command_for_agent(
                agent,
                cwd=cwd,
                mode=mode,
                prompt=str(turn["prompt"]),
                model=model,
                trust=trust,
                reasoning=clean_reasoning,
                attachments=[Path(str(path)) for path in (job.get("reference_paths") or [])],
            )
            if turn.get("kind") == "initial":
                job["command"] = turn["command"]

    return update_job(job_id, change)


def set_job_archived(job_id: str, archived: bool) -> dict[str, object]:
    def change(job: dict[str, object]) -> None:
        job["archived"] = archived

    return update_job(job_id, change)


def stop_job(job_id: str) -> dict[str, object]:
    job = read_job(job_id)
    raw_pid = job.get("worker_pid", job.get("pid"))

    def mark_stopped(job_data: dict[str, object]) -> None:
        job_data["stop_requested"] = True
        job_data["state"] = "stopped"
        for turn in job_data.get("turns", []):
            if isinstance(turn, dict) and turn.get("status") in {"running", "queued"}:
                turn["status"] = "stopped"
                turn["finished_at"] = timestamp()

    updated = update_job(job_id, mark_stopped)
    if raw_pid:
        try:
            pid = int(raw_pid)
            if os.name == "nt":
                subprocess.run(
                    ["taskkill", "/PID", str(pid), "/T", "/F"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    check=False,
                )
            else:
                os.killpg(pid, signal.SIGTERM)
        except (OSError, TypeError, ValueError):
            pass
    return updated


def retry_job(job_id: str) -> dict[str, object]:
    return queue_job_message(
        job_id,
        "Retry the previous turn using the current model and task settings. Re-check the latest workspace state before continuing.",
    )


def ensure_job_worker(job: dict[str, object]) -> dict[str, object]:
    if job_status(job) == "queued" and not job.get("stop_requested"):
        try:
            spawn_job_worker(str(job["id"]))
            refreshed = read_job(str(job["id"]))
            refreshed["status"] = job_status(refreshed)
            return refreshed
        except (OSError, SystemExit):
            return job
    return job


def create_managed_task(
    target: str,
    task: str,
    cwd: Path,
    *,
    mode: str = "work",
    model: str | None = None,
    reasoning: str | None = None,
    caller: str | None = "user",
    trust: bool = False,
) -> str:
    task = task.strip()
    if not task:
        raise SystemExit("Provide a non-empty task.")
    if mode not in {"work", "consult"}:
        raise SystemExit("Mode must be `work` or `consult`.")
    if not cwd.exists():
        raise SystemExit(f"Working directory does not exist: {cwd}")
    routing_caller = caller if caller and caller in AGENTS else None
    agent = choose_target(routing_caller, task) if target == "auto" else resolve_agent(target)
    if not shutil.which(agent.command):
        raise SystemExit(f"{agent.display} CLI not found on PATH as `{agent.command}`.")
    prompt = build_prompt(caller, mode, task)
    cmd = command_for_agent(
        agent,
        cwd=cwd,
        mode=mode,
        prompt=prompt,
        model=model,
        trust=trust,
        reasoning=reasoning,
    )
    job_id, _ = create_background_job(
        agent,
        mode,
        cmd,
        cwd,
        task,
        caller=caller,
        model=model,
        reasoning=reasoning,
        trust=trust,
        prompt=prompt,
    )
    return job_id


def default_manager() -> str:
    manager = os.environ.get("SECOND_OPINION_MANAGER", "app").strip().lower()
    return manager if manager in MANAGER_CHOICES else "app"


def app_state_path() -> Path:
    return home_dir() / ".second-opinion" / "app.json"


def gui_python_executable() -> str:
    if os.name == "nt":
        pythonw = Path(sys.executable).with_name("pythonw.exe")
        if pythonw.exists():
            return str(pythonw)
    return sys.executable


def launch_native_app(job_id: str | None = None) -> tuple[bool, str]:
    try:
        import tkinter  # noqa: F401
    except ImportError:
        return False, "Tk is unavailable; use --manager terminal or --manager none (Linux packages often call it python3-tk)."
    if sys.platform.startswith("linux") and not (
        os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")
    ):
        return False, "No graphical display is available; use --manager terminal or --manager none."

    state_path = app_state_path()
    if state_path.exists():
        try:
            state = json.loads(state_path.read_text(encoding="utf-8"))
            pid = int(state["pid"])
            if is_process_running(pid):
                return True, f"native task manager already open (pid {pid})"
        except (OSError, ValueError, KeyError, json.JSONDecodeError):
            pass
        try:
            state_path.unlink()
        except OSError:
            pass

    log_path = home_dir() / ".second-opinion" / "app.log"
    log_path.parent.mkdir(parents=True, exist_ok=True)
    log_file = log_path.open("a", encoding="utf-8")
    cmd = [gui_python_executable(), str(script_path()), "_app"]
    if job_id:
        cmd.extend(["--job", job_id])
    process = subprocess.Popen(
        cmd,
        stdin=subprocess.DEVNULL,
        stdout=log_file,
        stderr=subprocess.STDOUT,
        close_fds=True,
        **process_group_options(detach_console=True),
    )
    log_file.close()
    atomic_write_json(state_path, {"pid": process.pid, "started_at": timestamp()})
    track_detached_process(process)
    return True, f"native task manager opened (pid {process.pid})"


def launch_terminal_manager(job_id: str | None = None) -> tuple[bool, str]:
    cmd = [sys.executable, str(script_path()), "tui"]
    if job_id:
        cmd.extend(["--job", job_id])
    try:
        if sys.platform == "darwin":
            command_text = shlex.join(cmd)
            script = f'tell application "Terminal" to do script {json.dumps(command_text)}'
            completed = subprocess.run(
                ["osascript", "-e", script],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.PIPE,
                text=True,
                check=False,
            )
            if completed.returncode == 0:
                return True, "terminal task manager opened"
            return False, completed.stderr.strip() or "Terminal could not be opened"
        if os.name == "nt":
            creationflags = getattr(subprocess, "CREATE_NEW_CONSOLE", 0)
            process = subprocess.Popen(cmd, creationflags=creationflags)
            track_detached_process(process)
            return True, f"terminal task manager opened (pid {process.pid})"

        candidates = (
            ("x-terminal-emulator", ["-e"]),
            ("gnome-terminal", ["--"]),
            ("konsole", ["-e"]),
            ("xfce4-terminal", ["-e"]),
        )
        for command, prefix in candidates:
            executable = shutil.which(command)
            if not executable:
                continue
            process = subprocess.Popen(
                [executable, *prefix, *cmd],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                **process_group_options(),
            )
            track_detached_process(process)
            return True, f"terminal task manager opened with {command}"
        return False, "No supported terminal emulator was found; run `second-opinion tui` in a terminal."
    except OSError as error:
        return False, f"Could not open a terminal manager: {error}"


def open_manager(manager: str, job_id: str | None = None) -> tuple[bool, str]:
    if manager == "app":
        return launch_native_app(job_id)
    if manager == "terminal":
        return launch_terminal_manager(job_id)
    return True, "no task manager window requested"


def selected_job_or_error(job_id: str | None) -> dict[str, object]:
    if not job_id:
        raise SystemExit("Select a task first with `select JOB_ID`.")
    return read_job(job_id)


def print_tui_help() -> None:
    print(
        dedent(
            """\
            Commands:
              list [all]                 List active tasks (or include archived tasks)
              select JOB_ID              Select a task
              log                        Show the selected task output
              send MESSAGE               Steer the selected task
              model MODEL|default        Change the model for future turns
              reasoning LEVEL|default    Change provider-native effort for future turns
              stop                       Stop the active turn
              retry                      Retry using current task settings
              archive | unarchive        Hide or restore the task
              new                        Create a managed task interactively
              help                       Show these commands
              quit                       Close the terminal manager
            """
        )
    )


def run_terminal_manager(initial_job_id: str | None = None) -> int:
    selected = initial_job_id
    print_banner()
    print("Low-memory terminal task manager. Type `help` for commands.")
    if selected:
        print(f"Selected {selected}")
    while True:
        reap_detached_processes()
        for job in list_jobs():
            ensure_job_worker(job)
        prompt = f"second-opinion[{selected[-12:] if selected else '-'}]> "
        try:
            raw = input(prompt).strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return 0
        if not raw:
            continue
        command, _, rest = raw.partition(" ")
        command = command.lower()
        rest = rest.strip()
        try:
            if command in {"quit", "exit", "q"}:
                return 0
            if command in {"help", "?"}:
                print_tui_help()
            elif command == "list":
                jobs = list_jobs(include_archived=rest.lower() == "all")
                if not jobs:
                    print("No tasks found.")
                for job in jobs:
                    archived = " archived" if job.get("archived") else ""
                    marker = "*" if job.get("id") == selected else " "
                    print(
                        f"{marker} {job.get('id')}  {job.get('status'):<8} "
                        f"{job.get('agent_name')}  "
                        f"{str(job.get('role') or job.get('task', ''))[:62]}{archived}"
                    )
            elif command == "select":
                selected_job_or_error(rest)
                selected = rest
                print(f"Selected {selected}")
            elif command == "log":
                print(log_tail(selected_job_or_error(selected)) or "No output yet.")
            elif command == "send":
                selected_job_or_error(selected)
                queue_job_message(str(selected), rest)
                print("Steering message queued through the task's native harness.")
            elif command == "model":
                selected_job_or_error(selected)
                set_job_model(str(selected), None if rest.lower() == "default" else rest)
                print(f"Model for future turns: {rest or 'default'}")
            elif command in {"reasoning", "effort"}:
                selected_job_or_error(selected)
                set_job_reasoning(str(selected), None if rest.lower() == "default" else rest)
                print(f"Reasoning effort for future turns: {rest or 'default'}")
            elif command == "stop":
                stop_job(str(selected_job_or_error(selected)["id"]))
                print("Stop requested.")
            elif command == "retry":
                retry_job(str(selected_job_or_error(selected)["id"]))
                print("Retry queued.")
            elif command in {"archive", "unarchive"}:
                selected_job_or_error(selected)
                set_job_archived(str(selected), command == "archive")
                print("Task archived." if command == "archive" else "Task restored.")
            elif command == "new":
                task = input("Task: ").strip()
                target = input("Agent [auto]: ").strip().lower() or "auto"
                cwd = Path(input(f"Workspace [{Path.cwd()}]: ").strip() or Path.cwd()).expanduser().resolve()
                mode = input("Mode [work/consult, default work]: ").strip().lower() or "work"
                model = input("Model [provider default]: ").strip() or None
                reasoning = input("Reasoning effort [provider default]: ").strip() or None
                selected = create_managed_task(target, task, cwd, mode=mode, model=model, reasoning=reasoning)
                print(f"Created and selected {selected}")
            else:
                print("Unknown command. Type `help`.")
        except (OSError, SystemExit, ValueError) as error:
            print(f"error: {error}")


def run_native_app(initial_job_id: str | None = None) -> int:
    """Run the opt-in low-memory native task manager."""
    try:
        import tkinter as tk
        from tkinter import filedialog, messagebox, ttk
    except ImportError:
        print(
            "Second Opinion's native manager needs Tk. Use `second-opinion tui` instead "
            "(Linux packages often call Tk `python3-tk`).",
            file=sys.stderr,
        )
        return 1

    colors = {
        "bg": "#0b0f14",
        "panel": "#111821",
        "panel_alt": "#151f2b",
        "border": "#263241",
        "text": "#edf3f9",
        "muted": "#91a0b2",
        "accent": "#72e6b1",
        "accent_dark": "#173c31",
        "danger": "#ff7a85",
        "warning": "#ffc66d",
        "selection": "#213f3b",
    }

    root = tk.Tk()
    root.title("Second Opinion · Task Manager")
    root.geometry("1180x760")
    root.minsize(920, 600)
    root.configure(bg=colors["bg"])
    try:
        root.tk.call("tk", "scaling", max(1.0, float(root.winfo_fpixels("1i")) / 96.0))
    except (tk.TclError, ValueError):
        pass

    style_kit = ttk.Style(root)
    try:
        style_kit.theme_use("clam")
    except tk.TclError:
        pass
    style_kit.configure(".", background=colors["bg"], foreground=colors["text"], font=("TkDefaultFont", 11))
    style_kit.configure("Panel.TFrame", background=colors["panel"])
    style_kit.configure("Alt.TFrame", background=colors["panel_alt"])
    style_kit.configure("Title.TLabel", background=colors["panel"], foreground=colors["text"], font=("TkDefaultFont", 17, "bold"))
    style_kit.configure("TaskTitle.TLabel", background=colors["bg"], foreground=colors["text"], font=("TkDefaultFont", 18, "bold"))
    style_kit.configure("Muted.TLabel", background=colors["bg"], foreground=colors["muted"], font=("TkDefaultFont", 10))
    style_kit.configure("PanelMuted.TLabel", background=colors["panel"], foreground=colors["muted"], font=("TkDefaultFont", 10))
    style_kit.configure("Meta.TLabel", background=colors["panel_alt"], foreground=colors["muted"], font=("TkDefaultFont", 9, "bold"))
    style_kit.configure("MetaValue.TLabel", background=colors["panel_alt"], foreground=colors["text"])
    style_kit.configure("Accent.TButton", background=colors["accent"], foreground="#07130f", padding=(14, 8), font=("TkDefaultFont", 10, "bold"))
    style_kit.map("Accent.TButton", background=[("active", "#91f0c5"), ("disabled", colors["border"])])
    style_kit.configure("Quiet.TButton", background=colors["panel_alt"], foreground=colors["text"], padding=(11, 7))
    style_kit.map("Quiet.TButton", background=[("active", colors["border"])])
    style_kit.configure("Danger.TButton", background="#3b2028", foreground=colors["danger"], padding=(11, 7))
    style_kit.map("Danger.TButton", background=[("active", "#542833")])
    style_kit.configure("Dark.TCheckbutton", background=colors["panel"], foreground=colors["muted"])
    style_kit.map("Dark.TCheckbutton", background=[("active", colors["panel"])])
    style_kit.configure("Dark.TCombobox", fieldbackground=colors["bg"], background=colors["panel_alt"], foreground=colors["text"], arrowcolor=colors["muted"])

    class TaskManager:
        def __init__(self) -> None:
            self.current_id = initial_job_id
            self.displayed_id: str | None = None
            self.job_ids: list[str] = []
            self.list_signature: tuple[object, ...] = ()
            self.last_log = ""
            self.closed = False
            self.refresh_after: str | None = None
            self.show_archived = tk.BooleanVar(value=False)
            self.model_var = tk.StringVar()
            self.reasoning_var = tk.StringVar()
            self.status_var = tk.StringVar(value="No task selected")
            self.title_var = tk.StringVar(value="Select a task")
            self.harness_var = tk.StringVar(value="—")
            self.mode_var = tk.StringVar(value="—")
            self.cwd_var = tk.StringVar(value="—")
            self.model_note_var = tk.StringVar(value="Model changes apply to the next agent turn.")
            self._build()
            self.refresh()

        def _build(self) -> None:
            root.grid_columnconfigure(1, weight=1)
            root.grid_rowconfigure(0, weight=1)

            sidebar = ttk.Frame(root, style="Panel.TFrame", width=310, padding=(18, 18))
            sidebar.grid(row=0, column=0, sticky="nsew")
            sidebar.grid_propagate(False)
            sidebar.grid_columnconfigure(0, weight=1)
            sidebar.grid_rowconfigure(2, weight=1)

            head = ttk.Frame(sidebar, style="Panel.TFrame")
            head.grid(row=0, column=0, sticky="ew", pady=(0, 14))
            head.grid_columnconfigure(0, weight=1)
            ttk.Label(head, text="Second Opinion", style="Title.TLabel").grid(row=0, column=0, sticky="w")
            ttk.Label(head, text="Native task manager", style="PanelMuted.TLabel").grid(row=1, column=0, sticky="w", pady=(2, 0))
            ttk.Button(head, text="＋ New", style="Accent.TButton", command=self.new_task).grid(row=0, column=1, rowspan=2, sticky="e")

            filter_row = ttk.Frame(sidebar, style="Panel.TFrame")
            filter_row.grid(row=1, column=0, sticky="ew", pady=(0, 10))
            ttk.Label(filter_row, text="TASKS", style="PanelMuted.TLabel").pack(side="left")
            ttk.Checkbutton(
                filter_row,
                text="Show archived",
                variable=self.show_archived,
                command=lambda: self.refresh(force=True),
                style="Dark.TCheckbutton",
            ).pack(side="right")

            self.task_list = tk.Listbox(
                sidebar,
                bg=colors["panel"],
                fg=colors["text"],
                selectbackground=colors["selection"],
                selectforeground=colors["text"],
                highlightthickness=1,
                highlightbackground=colors["border"],
                highlightcolor=colors["accent"],
                borderwidth=0,
                activestyle="none",
                font=("TkDefaultFont", 11),
                relief="flat",
                exportselection=False,
            )
            self.task_list.grid(row=2, column=0, sticky="nsew")
            self.task_list.bind("<<ListboxSelect>>", self.select_from_list)
            ttk.Label(
                sidebar,
                text="Only Second Opinion tasks appear here.\nClosing this window does not stop them.",
                style="PanelMuted.TLabel",
                justify="left",
            ).grid(row=3, column=0, sticky="w", pady=(12, 0))

            main = ttk.Frame(root, padding=(24, 20))
            main.grid(row=0, column=1, sticky="nsew")
            main.grid_columnconfigure(0, weight=1)
            main.grid_rowconfigure(3, weight=1)

            title_row = ttk.Frame(main)
            title_row.grid(row=0, column=0, sticky="ew")
            title_row.grid_columnconfigure(0, weight=1)
            ttk.Label(title_row, textvariable=self.title_var, style="TaskTitle.TLabel", wraplength=720).grid(row=0, column=0, sticky="w")
            self.status_label = tk.Label(
                title_row,
                textvariable=self.status_var,
                bg=colors["accent_dark"],
                fg=colors["accent"],
                padx=11,
                pady=5,
                font=("TkDefaultFont", 9, "bold"),
            )
            self.status_label.grid(row=0, column=1, sticky="e")

            meta = ttk.Frame(main, style="Alt.TFrame", padding=(15, 12))
            meta.grid(row=1, column=0, sticky="ew", pady=(16, 12))
            for column in range(4):
                meta.grid_columnconfigure(column, weight=1 if column in {1, 3} else 0)
            ttk.Label(meta, text="HARNESS", style="Meta.TLabel").grid(row=0, column=0, sticky="w")
            ttk.Label(meta, textvariable=self.harness_var, style="MetaValue.TLabel").grid(row=1, column=0, sticky="w", padx=(0, 24))
            ttk.Label(meta, text="MODE", style="Meta.TLabel").grid(row=0, column=1, sticky="w")
            ttk.Label(meta, textvariable=self.mode_var, style="MetaValue.TLabel").grid(row=1, column=1, sticky="w", padx=(0, 24))
            ttk.Label(meta, text="WORKSPACE", style="Meta.TLabel").grid(row=0, column=2, sticky="w")
            ttk.Label(meta, textvariable=self.cwd_var, style="MetaValue.TLabel", wraplength=360).grid(row=1, column=2, columnspan=2, sticky="w")

            controls = ttk.Frame(main)
            controls.grid(row=2, column=0, sticky="ew", pady=(0, 12))
            ttk.Label(controls, text="Model for next turn", style="Muted.TLabel").pack(side="left")
            self.model_entry = tk.Entry(
                controls,
                textvariable=self.model_var,
                bg=colors["panel_alt"],
                fg=colors["text"],
                insertbackground=colors["text"],
                highlightthickness=1,
                highlightbackground=colors["border"],
                highlightcolor=colors["accent"],
                relief="flat",
                width=26,
                font=("TkDefaultFont", 10),
            )
            self.model_entry.pack(side="left", padx=(9, 6), ipady=6)
            ttk.Label(controls, text="Effort", style="Muted.TLabel").pack(side="left", padx=(8, 0))
            self.reasoning_entry = tk.Entry(
                controls,
                textvariable=self.reasoning_var,
                bg=colors["panel_alt"],
                fg=colors["text"],
                insertbackground=colors["text"],
                highlightthickness=1,
                highlightbackground=colors["border"],
                highlightcolor=colors["accent"],
                relief="flat",
                width=9,
                font=("TkDefaultFont", 10),
            )
            self.reasoning_entry.pack(side="left", padx=(9, 6), ipady=6)
            self.apply_model_button = ttk.Button(controls, text="Apply", style="Quiet.TButton", command=self.apply_settings)
            self.apply_model_button.pack(side="left")
            self.archive_button = ttk.Button(controls, text="Archive", style="Quiet.TButton", command=self.toggle_archive)
            self.archive_button.pack(side="right")
            self.retry_button = ttk.Button(controls, text="Retry", style="Quiet.TButton", command=self.retry)
            self.retry_button.pack(side="right", padx=6)
            self.stop_button = ttk.Button(controls, text="Stop", style="Danger.TButton", command=self.stop)
            self.stop_button.pack(side="right")

            transcript_frame = ttk.Frame(main, style="Alt.TFrame", padding=(1, 1))
            transcript_frame.grid(row=3, column=0, sticky="nsew")
            transcript_frame.grid_columnconfigure(0, weight=1)
            transcript_frame.grid_rowconfigure(0, weight=1)
            self.transcript = tk.Text(
                transcript_frame,
                bg=colors["panel_alt"],
                fg=colors["text"],
                insertbackground=colors["text"],
                selectbackground=colors["selection"],
                borderwidth=0,
                padx=16,
                pady=14,
                wrap="word",
                state="disabled",
                font=("TkFixedFont", 10),
                spacing1=2,
                spacing3=3,
            )
            transcript_scroll = ttk.Scrollbar(transcript_frame, command=self.transcript.yview)
            self.transcript.configure(yscrollcommand=transcript_scroll.set)
            self._configure_markdown_tags()
            self.transcript.grid(row=0, column=0, sticky="nsew")
            transcript_scroll.grid(row=0, column=1, sticky="ns")

            ttk.Label(main, textvariable=self.model_note_var, style="Muted.TLabel").grid(row=4, column=0, sticky="w", pady=(9, 5))
            compose = ttk.Frame(main, style="Alt.TFrame", padding=(10, 10))
            compose.grid(row=5, column=0, sticky="ew")
            compose.grid_columnconfigure(0, weight=1)
            self.message = tk.Text(
                compose,
                height=3,
                bg=colors["panel_alt"],
                fg=colors["text"],
                insertbackground=colors["text"],
                selectbackground=colors["selection"],
                borderwidth=0,
                wrap="word",
                font=("TkDefaultFont", 11),
            )
            self.message.grid(row=0, column=0, sticky="ew", padx=(4, 10))
            self.send_button = ttk.Button(compose, text="Send →", style="Accent.TButton", command=self.send)
            self.send_button.grid(row=0, column=1, sticky="se")
            self.message.bind("<Control-Return>", lambda _: self.send() or "break")
            self.message.bind("<Command-Return>", lambda _: self.send() or "break")
            root.bind("<Control-n>", lambda _: self.new_task())
            root.bind("<Command-n>", lambda _: self.new_task())

        def _configure_markdown_tags(self) -> None:
            transcript = self.transcript
            transcript.configure(font=("TkDefaultFont", 11), spacing1=2, spacing3=3)
            transcript.tag_configure("md_heading1", foreground=colors["text"], spacing1=12, spacing3=7)
            transcript.tag_configure("md_heading2", foreground=colors["text"], spacing1=10, spacing3=6)
            transcript.tag_configure("md_heading3", foreground=colors["text"], spacing1=8, spacing3=4)
            transcript.tag_configure(
                "md_inline_code",
                background="#202b38",
                foreground="#dce9f5",
            )
            transcript.tag_configure(
                "md_code_block",
                background="#0d141c",
                foreground="#dce9f5",
                lmargin1=14,
                lmargin2=14,
                rmargin=12,
                spacing1=3,
                spacing3=3,
            )
            transcript.tag_configure(
                "md_quote",
                foreground="#b8c7d7",
                lmargin1=12,
                lmargin2=12,
                spacing1=2,
                spacing3=2,
            )
            transcript.tag_configure("md_list", lmargin1=8, lmargin2=22)
            transcript.tag_configure("md_table", lmargin1=8, lmargin2=8, spacing1=2, spacing3=2)
            transcript.tag_configure("md_separator", foreground=colors["border"])
            transcript.tag_configure("md_strikethrough", overstrike=True)
            transcript.tag_configure("md_link", foreground=colors["accent"], underline=True)

            transcript.tag_configure("md_font_body", font=("TkDefaultFont", 11))
            transcript.tag_configure("md_font_body_bold", font=("TkDefaultFont", 11, "bold"))
            transcript.tag_configure("md_font_body_italic", font=("TkDefaultFont", 11, "italic"))
            transcript.tag_configure("md_font_body_bold_italic", font=("TkDefaultFont", 11, "bold italic"))
            transcript.tag_configure("md_font_heading1", font=("TkDefaultFont", 18, "bold"))
            transcript.tag_configure("md_font_heading1_italic", font=("TkDefaultFont", 18, "bold italic"))
            transcript.tag_configure("md_font_heading2", font=("TkDefaultFont", 15, "bold"))
            transcript.tag_configure("md_font_heading2_italic", font=("TkDefaultFont", 15, "bold italic"))
            transcript.tag_configure("md_font_heading3", font=("TkDefaultFont", 12, "bold"))
            transcript.tag_configure("md_font_heading3_italic", font=("TkDefaultFont", 12, "bold italic"))
            transcript.tag_configure("md_font_code", font=("TkFixedFont", 10))
            transcript.tag_configure("md_font_table", font=("TkFixedFont", 10))
            transcript.tag_configure("md_font_table_bold", font=("TkFixedFont", 10, "bold"))

        def _markdown_widget_tags(self, tags: tuple[str, ...]) -> tuple[str, ...]:
            semantic = set(tags)
            if "code_block" in semantic or "inline_code" in semantic:
                font_tag = "md_font_code"
            elif "table" in semantic:
                font_tag = "md_font_table_bold" if "table_header" in semantic else "md_font_table"
            elif "heading1" in semantic:
                font_tag = "md_font_heading1_italic" if "italic" in semantic else "md_font_heading1"
            elif "heading2" in semantic:
                font_tag = "md_font_heading2_italic" if "italic" in semantic else "md_font_heading2"
            elif "heading3" in semantic:
                font_tag = "md_font_heading3_italic" if "italic" in semantic else "md_font_heading3"
            elif "bold" in semantic and "italic" in semantic:
                font_tag = "md_font_body_bold_italic"
            elif "bold" in semantic:
                font_tag = "md_font_body_bold"
            elif "italic" in semantic:
                font_tag = "md_font_body_italic"
            else:
                font_tag = "md_font_body"

            widget_tags = [font_tag]
            for semantic_tag in (
                "heading1",
                "heading2",
                "heading3",
                "inline_code",
                "code_block",
                "quote",
                "list",
                "table",
                "separator",
                "strikethrough",
                "link",
            ):
                if semantic_tag in semantic:
                    widget_tags.append(f"md_{semantic_tag}")
            return tuple(widget_tags)

        def _insert_markdown(self, content: str) -> None:
            for tag_name in self.transcript.tag_names():
                if str(tag_name).startswith("md_link_target_"):
                    self.transcript.tag_delete(tag_name)

            link_index = 0
            for text, semantic_tags, target in markdown_runs(content):
                widget_tags = list(self._markdown_widget_tags(semantic_tags))
                if target:
                    link_tag = f"md_link_target_{link_index}"
                    link_index += 1
                    self.transcript.tag_bind(
                        link_tag,
                        "<Button-1>",
                        lambda _event, url=target: self._open_markdown_link(url),
                    )
                    self.transcript.tag_bind(
                        link_tag,
                        "<Enter>",
                        lambda _event: self.transcript.configure(cursor="hand2"),
                    )
                    self.transcript.tag_bind(
                        link_tag,
                        "<Leave>",
                        lambda _event: self.transcript.configure(cursor="xterm"),
                    )
                    widget_tags.append(link_tag)
                self.transcript.insert("end", text, tuple(widget_tags))

        @staticmethod
        def _open_markdown_link(target: str) -> str:
            import webbrowser

            try:
                webbrowser.open_new_tab(target)
            except (OSError, webbrowser.Error):
                pass
            return "break"

        def refresh(self, force: bool = False) -> None:
            if self.closed:
                return
            reap_detached_processes()
            if self.refresh_after:
                try:
                    root.after_cancel(self.refresh_after)
                except tk.TclError:
                    pass
                self.refresh_after = None
            jobs = [ensure_job_worker(job) for job in list_jobs(include_archived=self.show_archived.get())]
            signature = tuple(
                (job.get("id"), job.get("status"), job.get("archived"), job.get("updated_at"))
                for job in jobs
            )
            if force or signature != self.list_signature:
                self.list_signature = signature
                self.job_ids = [str(job["id"]) for job in jobs]
                self.task_list.delete(0, "end")
                for job in jobs:
                    status = str(job.get("status", "finished"))
                    symbol = {"running": "●", "queued": "◌", "failed": "!", "stopped": "■"}.get(status, "✓")
                    task = " ".join(str(job.get("role") or job.get("task", "Untitled task")).split())
                    suffix = "  · archived" if job.get("archived") else ""
                    team = f" · {job.get('worker_index')}/{job.get('worker_count')}" if job.get("team_id") else ""
                    self.task_list.insert("end", f"{symbol}  {job.get('agent_name')}{team}\n    {task[:44]}{suffix}")
                if self.current_id not in self.job_ids:
                    self.current_id = self.job_ids[0] if self.job_ids else None
                if self.current_id in self.job_ids:
                    index = self.job_ids.index(str(self.current_id))
                    self.task_list.selection_clear(0, "end")
                    self.task_list.selection_set(index)
                    self.task_list.see(index)
            self.render_current()
            self.refresh_after = root.after(900, self.refresh)

        def select_from_list(self, _event=None) -> None:
            selected = self.task_list.curselection()
            if selected and selected[0] < len(self.job_ids):
                self.current_id = self.job_ids[selected[0]]
                self.displayed_id = None
                self.last_log = ""
                self.render_current()

        def render_current(self) -> None:
            if not self.current_id:
                self.title_var.set("No Second Opinion tasks yet")
                self.status_var.set("IDLE")
                self.harness_var.set("—")
                self.mode_var.set("—")
                self.cwd_var.set("Start one with + New")
                self.set_log("Create a task here, or run `second-opinion ask … --background`.\n\nThe manager remains isolated from your coding-agent apps and only reads Second Opinion's own job records.")
                self.set_controls(False)
                return
            try:
                job = read_job(self.current_id)
            except SystemExit:
                self.current_id = None
                return
            status = job_status(job)
            if job.get("team_id"):
                task = (
                    f"{job.get('team_name') or 'Parallel team'} · {job.get('role')} "
                    f"({job.get('worker_index')}/{job.get('worker_count')})"
                )
            else:
                task = " ".join(str(job.get("task", "Untitled task")).split())
            self.title_var.set(task[:110] or "Untitled task")
            self.status_var.set(status.upper())
            status_colors = {
                "running": (colors["accent_dark"], colors["accent"]),
                "queued": ("#383018", colors["warning"]),
                "failed": ("#3b2028", colors["danger"]),
                "stopped": ("#30282b", "#d6b2b7"),
                "finished": ("#1d3042", "#9dc9ee"),
            }
            bg, fg = status_colors.get(status, (colors["panel_alt"], colors["muted"]))
            self.status_label.configure(bg=bg, fg=fg)
            self.harness_var.set(str(job.get("agent_name", job.get("agent", "—"))))
            self.mode_var.set(str(job.get("mode", "—")).upper())
            self.cwd_var.set(str(job.get("cwd", "—")))
            if self.displayed_id != self.current_id:
                self.model_var.set(str(job.get("model") or ""))
                self.reasoning_var.set(str(job.get("reasoning") or ""))
                self.displayed_id = self.current_id
            self.archive_button.configure(text="Unarchive" if job.get("archived") else "Archive")
            self.model_note_var.set(
                "Message queued; it will run after the active turn." if status == "running" else "Model changes apply to the next agent turn. Provider default is used when blank."
            )
            self.set_log(log_tail(job) or "Waiting for the provider harness to produce output…")
            self.set_controls(True, running=status == "running", archived=bool(job.get("archived")))

        def set_log(self, content: str) -> None:
            if content == self.last_log:
                return
            at_bottom = self.transcript.yview()[1] > 0.97
            self.transcript.configure(state="normal")
            self.transcript.delete("1.0", "end")
            self._insert_markdown(content)
            self.transcript.configure(state="disabled")
            if at_bottom or not self.last_log:
                self.transcript.see("end")
            self.last_log = content

        def set_controls(self, enabled: bool, *, running: bool = False, archived: bool = False) -> None:
            regular = "normal" if enabled else "disabled"
            self.model_entry.configure(state=regular)
            self.reasoning_entry.configure(state=regular)
            self.apply_model_button.configure(state=regular)
            self.retry_button.configure(state="normal" if enabled and not archived else "disabled")
            self.archive_button.configure(state=regular)
            self.stop_button.configure(state="normal" if enabled and running else "disabled")
            self.message.configure(state="normal" if enabled and not archived else "disabled")
            self.send_button.configure(state="normal" if enabled and not archived else "disabled")

        def apply_settings(self) -> None:
            if not self.current_id:
                return
            try:
                set_job_model(self.current_id, self.model_var.get())
                set_job_reasoning(self.current_id, self.reasoning_var.get())
                self.model_note_var.set("Saved. Model and effort will be passed to the next native harness turn.")
            except (OSError, SystemExit) as error:
                messagebox.showerror("Could not change model", str(error), parent=root)

        def send(self) -> None:
            if not self.current_id:
                return
            message = self.message.get("1.0", "end").strip()
            if not message:
                return
            try:
                queue_job_message(self.current_id, message)
                self.message.delete("1.0", "end")
                self.refresh(force=True)
            except (OSError, SystemExit) as error:
                messagebox.showerror("Could not send message", str(error), parent=root)

        def stop(self) -> None:
            if not self.current_id:
                return
            if not messagebox.askyesno("Stop active turn?", "The provider process will be stopped. Workspace edits already made are not reverted.", parent=root):
                return
            stop_job(self.current_id)
            self.refresh(force=True)

        def retry(self) -> None:
            if not self.current_id:
                return
            try:
                retry_job(self.current_id)
                self.refresh(force=True)
            except (OSError, SystemExit) as error:
                messagebox.showerror("Could not retry task", str(error), parent=root)

        def toggle_archive(self) -> None:
            if not self.current_id:
                return
            job = read_job(self.current_id)
            archived = not bool(job.get("archived"))
            set_job_archived(self.current_id, archived)
            if archived and not self.show_archived.get():
                self.current_id = None
                self.displayed_id = None
            self.refresh(force=True)

        def new_task(self) -> None:
            dialog = tk.Toplevel(root)
            dialog.title("New Second Opinion Task")
            dialog.configure(bg=colors["bg"])
            dialog.geometry("620x610")
            dialog.minsize(520, 540)
            dialog.transient(root)
            dialog.grab_set()
            frame = ttk.Frame(dialog, padding=22)
            frame.pack(fill="both", expand=True)
            frame.grid_columnconfigure(0, weight=1)
            ttk.Label(frame, text="New task", style="TaskTitle.TLabel").grid(row=0, column=0, columnspan=3, sticky="w")
            ttk.Label(frame, text="Runs through the selected agent's own CLI, auth, tools, and safety policy.", style="Muted.TLabel").grid(row=1, column=0, columnspan=3, sticky="w", pady=(4, 18))
            ttk.Label(frame, text="Task", style="Muted.TLabel").grid(row=2, column=0, columnspan=3, sticky="w")
            task_widget = tk.Text(frame, height=7, bg=colors["panel_alt"], fg=colors["text"], insertbackground=colors["text"], borderwidth=0, padx=10, pady=8, wrap="word")
            task_widget.grid(row=3, column=0, columnspan=3, sticky="nsew", pady=(5, 14))
            frame.grid_rowconfigure(3, weight=1)
            target_var = tk.StringVar(value="auto")
            mode_var = tk.StringVar(value="work")
            model_var = tk.StringVar()
            reasoning_var = tk.StringVar()
            cwd_var = tk.StringVar(value=str(Path.cwd()))
            ttk.Label(frame, text="Agent", style="Muted.TLabel").grid(row=4, column=0, sticky="w")
            ttk.Label(frame, text="Mode", style="Muted.TLabel").grid(row=4, column=1, sticky="w", padx=(12, 0))
            ttk.Label(frame, text="Model (optional)", style="Muted.TLabel").grid(row=4, column=2, sticky="w", padx=(12, 0))
            ttk.Combobox(frame, textvariable=target_var, values=("auto", *AGENTS.keys()), state="readonly", style="Dark.TCombobox").grid(row=5, column=0, sticky="ew", pady=(5, 14))
            ttk.Combobox(frame, textvariable=mode_var, values=("work", "consult"), state="readonly", width=10, style="Dark.TCombobox").grid(row=5, column=1, sticky="ew", padx=(12, 0), pady=(5, 14))
            model_entry = tk.Entry(frame, textvariable=model_var, bg=colors["panel_alt"], fg=colors["text"], insertbackground=colors["text"], borderwidth=0)
            model_entry.grid(row=5, column=2, sticky="ew", padx=(12, 0), pady=(5, 14), ipady=6)
            ttk.Label(frame, text="Reasoning effort (optional)", style="Muted.TLabel").grid(row=6, column=0, columnspan=3, sticky="w")
            reasoning_entry = tk.Entry(frame, textvariable=reasoning_var, bg=colors["panel_alt"], fg=colors["text"], insertbackground=colors["text"], borderwidth=0)
            reasoning_entry.grid(row=7, column=0, columnspan=3, sticky="ew", pady=(5, 14), ipady=6)
            ttk.Label(frame, text="Workspace", style="Muted.TLabel").grid(row=8, column=0, columnspan=3, sticky="w")
            cwd_entry = tk.Entry(frame, textvariable=cwd_var, bg=colors["panel_alt"], fg=colors["text"], insertbackground=colors["text"], borderwidth=0)
            cwd_entry.grid(row=9, column=0, columnspan=2, sticky="ew", pady=(5, 18), ipady=6)

            def browse() -> None:
                chosen = filedialog.askdirectory(parent=dialog, initialdir=cwd_var.get() or str(Path.cwd()))
                if chosen:
                    cwd_var.set(chosen)

            ttk.Button(frame, text="Browse", style="Quiet.TButton", command=browse).grid(row=9, column=2, sticky="ew", padx=(12, 0), pady=(5, 18))
            actions = ttk.Frame(frame)
            actions.grid(row=10, column=0, columnspan=3, sticky="e")
            ttk.Button(actions, text="Cancel", style="Quiet.TButton", command=dialog.destroy).pack(side="left", padx=(0, 8))

            def create() -> None:
                task = task_widget.get("1.0", "end").strip()
                if not task:
                    messagebox.showwarning("Task required", "Describe what the second-opinion agent should do.", parent=dialog)
                    return
                try:
                    cwd = Path(cwd_var.get()).expanduser().resolve()
                    if not cwd.exists():
                        raise SystemExit(f"Working directory does not exist: {cwd}")
                    self.current_id = create_managed_task(
                        target_var.get(),
                        task,
                        cwd,
                        mode=mode_var.get(),
                        model=model_var.get() or None,
                        reasoning=reasoning_var.get() or None,
                    )
                    self.displayed_id = None
                    dialog.destroy()
                    self.refresh(force=True)
                except (OSError, SystemExit, ValueError) as error:
                    messagebox.showerror("Could not create task", str(error), parent=dialog)

            ttk.Button(actions, text="Start task", style="Accent.TButton", command=create).pack(side="left")
            task_widget.focus_set()

        def close(self) -> None:
            self.closed = True
            state_path = app_state_path()
            try:
                state = json.loads(state_path.read_text(encoding="utf-8"))
                if int(state.get("pid", 0)) == os.getpid():
                    state_path.unlink()
            except (OSError, ValueError, json.JSONDecodeError):
                pass
            root.destroy()

    atomic_write_json(app_state_path(), {"pid": os.getpid(), "started_at": timestamp()})
    manager = TaskManager()
    root.protocol("WM_DELETE_WINDOW", manager.close)
    try:
        root.mainloop()
    finally:
        if not manager.closed:
            manager.close()
    return 0


def cmd_tui(args: argparse.Namespace) -> int:
    return run_terminal_manager(args.job)


def cmd_app(args: argparse.Namespace) -> int:
    if args.foreground:
        return run_native_app(args.job)
    opened, detail = launch_native_app(args.job)
    print(detail)
    return 0 if opened else 1


def cmd_internal_app(args: argparse.Namespace) -> int:
    return run_native_app(args.job)


def cmd_internal_worker(args: argparse.Namespace) -> int:
    return run_job_worker(args.job_id)


def cmd_status(args: argparse.Namespace) -> int:
    detected = detect_agents()
    if args.json:
        print(json.dumps({"version": VERSION, "agents": detected}, indent=2))
        return 0
    print_banner()
    for key, info in detected.items():
        command = info["command_path"] or "not found"
        skill = "installed" if info["skill_installed"] else "not installed"
        command_color = "green" if info["detected"] else "yellow"
        skill_color = "green" if info["skill_installed"] else "yellow"
        print(f"{info['name']:<12} command: {style(command, command_color)}")
        print(f"{'':<12} skill:   {style(skill, skill_color)}")
        print(f"{'':<12} path:    {info['skill_path']}")
    return 0


def cmd_install(args: argparse.Namespace) -> int:
    if args.home:
        os.environ["SECOND_OPINION_HOME"] = args.home
    if args.all:
        targets = list(AGENTS)
    elif args.agent:
        targets = [resolve_agent(agent).key for agent in args.agent]
    elif args.yes or not sys.stdin.isatty():
        targets = default_install_targets()
    else:
        targets = interactive_targets()
    if not targets:
        print("No skills installed.")
        return 0
    return install_agents(targets, force=args.force, dry_run=args.dry_run)


def cmd_update(args: argparse.Namespace) -> int:
    if args.home:
        os.environ["SECOND_OPINION_HOME"] = args.home

    target = current_executable_path(args.path)
    current_bytes = target.read_bytes() if target.exists() else b""
    current_version = parse_cli_version(read_text_bytes(current_bytes)) or VERSION
    url, remote_bytes, remote_version = download_cli(args.base_url)

    same_bytes = current_bytes == remote_bytes
    should_update = args.force or (not same_bytes and version_is_newer(remote_version, current_version))

    print(f"Current: {current_version} at {target}")
    print(f"Remote:  {remote_version} from {url}")

    if same_bytes:
        print("Second Opinion CLI is already up to date.")
        return 0

    if not should_update:
        print("No newer CLI version found. Use --force to reinstall the downloaded version anyway.")
        return 0

    if args.dry_run:
        print(f"Would update {target} to {remote_version}.")
        return 0

    replace_executable(target, remote_bytes)
    print(f"Updated Second Opinion CLI to {remote_version}.")

    if args.skip_skills:
        skill_rc = 0
    else:
        skill_targets = list(AGENTS) if args.all_skills else managed_installed_targets()
        if not skill_targets:
            print("No managed skill files found to refresh.")
            skill_rc = 0
        else:
            cmd = [str(target), "install", "--yes"]
            for key in skill_targets:
                cmd.extend(["--agent", key])
            print(f"Refreshing managed skills: {', '.join(skill_targets)}")
            completed = subprocess.run(cmd, text=True, check=False)
            skill_rc = completed.returncode

    return skill_rc


def cmd_uninstall(args: argparse.Namespace) -> int:
    if args.home:
        os.environ["SECOND_OPINION_HOME"] = args.home
    if args.all:
        targets = list(AGENTS)
    elif args.agent:
        targets = [resolve_agent(agent).key for agent in args.agent]
    else:
        raise SystemExit("Choose --all or at least one --agent.")
    return uninstall_agents(targets, dry_run=args.dry_run)


def cmd_choose(args: argparse.Namespace) -> int:
    task = task_from_parts(args.task_parts, args.task)
    agent = choose_target(args.caller, task, include_self=args.include_self)
    if args.json:
        print(json.dumps({"agent": agent.key, "name": agent.display, "command": agent.command}, indent=2))
    else:
        print(agent.key)
    return 0


def benchmark_rows(payload: dict[str, object]) -> list[dict[str, object]]:
    key = "models" if payload.get("kind") == "models" else "agents"
    rows = payload.get(key, [])
    return [row for row in rows if isinstance(row, dict)] if isinstance(rows, list) else []


def filter_and_sort_benchmarks(
    payload: dict[str, object], args: argparse.Namespace
) -> list[dict[str, object]]:
    rows = benchmark_rows(payload)
    if args.query:
        needle = args.query.casefold()
        rows = [row for row in rows if needle in " ".join(str(value) for value in row.values()).casefold()]
    if args.max_cost is not None:
        rows = [
            row for row in rows
            if isinstance(row.get("cost_per_task_usd"), (int, float))
            and float(row["cost_per_task_usd"]) <= args.max_cost
        ]
    for option, field in (
        (args.min_intelligence, "intelligence_index"),
        (args.min_coding, "coding_index"),
        (args.min_agentic, "agentic_index"),
        (args.min_agent_score, "coding_agent_index"),
    ):
        if option is not None:
            rows = [
                row for row in rows
                if isinstance(row.get(field), (int, float)) and float(row[field]) >= option
            ]

    model_fields = {
        "intelligence": "intelligence_index",
        "coding": "coding_index",
        "agentic": "agentic_index",
        "agent-score": "coding_agent_index",
        "cost": "cost_per_task_usd",
        "speed": "output_tokens_per_second",
        "time": "time_per_task_minutes",
        "name": "name",
    }
    field = model_fields[args.sort]
    if payload.get("kind") == "agents" and args.sort in {"intelligence", "coding", "agentic", "speed"}:
        field = "coding_agent_index"
    ascending = args.sort in {"cost", "time", "name"}

    def key(row: dict[str, object]) -> tuple[bool, object]:
        value = row.get(field)
        missing = value is None
        if isinstance(value, str):
            value = value.casefold()
        return missing, value if value is not None else ("" if args.sort == "name" else 0)

    present = [row for row in rows if row.get(field) is not None]
    missing = [row for row in rows if row.get(field) is None]
    present.sort(key=key, reverse=not ascending)
    return (present + missing)[: args.limit]


def format_metric(value: object, *, money: bool = False) -> str:
    if not isinstance(value, (int, float)):
        return "—"
    if money:
        return f"${float(value):.4f}" if float(value) < 1 else f"${float(value):.2f}"
    return f"{float(value):.1f}"


def print_benchmark_table(payload: dict[str, object], rows: list[dict[str, object]]) -> None:
    if payload.get("kind") == "models":
        print(f"{'MODEL':<43} {'INT':>6} {'CODE':>6} {'AGENT':>6} {'$/TASK':>9} {'MIN':>6}")
        for row in rows:
            print(
                f"{str(row.get('name', ''))[:43]:<43} "
                f"{format_metric(row.get('intelligence_index')):>6} "
                f"{format_metric(row.get('coding_index')):>6} "
                f"{format_metric(row.get('agentic_index')):>6} "
                f"{format_metric(row.get('cost_per_task_usd'), money=True):>9} "
                f"{format_metric(row.get('time_per_task_minutes')):>6}"
            )
    else:
        print(f"{'HARNESS + MODEL':<55} {'INDEX':>7} {'$/TASK':>9} {'MIN':>6}")
        for row in rows:
            print(
                f"{str(row.get('name', ''))[:55]:<55} "
                f"{format_metric(row.get('coding_agent_index')):>7} "
                f"{format_metric(row.get('cost_per_task_usd'), money=True):>9} "
                f"{format_metric(row.get('time_per_task_minutes')):>6}"
            )
    print()
    print(str(payload.get("attribution")))
    print(f"Source: {payload.get('source_url')} · cache: {payload.get('cache', 'unknown')}")


def cmd_benchmarks(args: argparse.Namespace) -> int:
    kinds = ("models", "agents") if args.kind == "all" else (args.kind,)
    outputs: dict[str, dict[str, object]] = {}
    for kind in kinds:
        payload = load_benchmark_data(kind, refresh=args.refresh, offline=args.offline)
        filtered = filter_and_sort_benchmarks(payload, args)
        output = {key: value for key, value in payload.items() if key not in {"models", "agents", "fetched_epoch"}}
        output["results"] = filtered
        output["result_count"] = len(filtered)
        outputs[kind] = output
    if args.json:
        result: object = outputs[args.kind] if args.kind != "all" else outputs
        print(json.dumps(result, indent=2))
        return 0
    for index, kind in enumerate(kinds):
        if index:
            print()
        title = "Model indices" if kind == "models" else "Coding Agent Index (harness + model)"
        print(style(f"Artificial Analysis · {title}", "bold"))
        rows = outputs[kind]["results"]
        print_benchmark_table(outputs[kind], rows if isinstance(rows, list) else [])
    return 0


def cmd_image_tools(args: argparse.Namespace) -> int:
    capabilities = detect_image_tools()
    if args.available:
        capabilities = {key: value for key, value in capabilities.items() if value["available"]}
    payload = {
        "version": VERSION,
        "capability": "image-generation",
        "agents": capabilities,
        "configuration": {
            "environment": "SECOND_OPINION_IMAGE_TOOLS=agent=tool,agent=tool",
            "models_environment": "SECOND_OPINION_IMAGE_MODELS=agent=model|model,agent=model",
            "note": "Declarations advertise existing native harness capabilities; they do not install tools or credentials.",
        },
    }
    if args.json:
        print(json.dumps(payload, indent=2))
        return 0
    print("Native image creation through coding harnesses")
    for key, info in capabilities.items():
        availability = "available" if info["available"] else "not detected"
        models = ", ".join(str(model) for model in info.get("models", [])) or "—"
        print(f"{key:<12} {availability:<13} {info.get('tool') or '—'} · {models}")
        if info.get("evidence"):
            print(f"{'':<12} evidence: {info['evidence']}")
    print()
    print("Second Opinion uses existing harness auth and never installs an image tool or handles its API keys.")
    return 0


def image_paths(args: argparse.Namespace, cwd: Path) -> tuple[Path, list[Path]]:
    output = Path(args.output).expanduser()
    output = (output if output.is_absolute() else cwd / output).resolve()
    try:
        output.relative_to(cwd)
    except ValueError as error:
        raise SystemExit(f"Image output must stay inside the workspace: {cwd}") from error
    if output.suffix.lower() not in IMAGE_EXTENSIONS:
        supported = ", ".join(sorted(IMAGE_EXTENSIONS))
        raise SystemExit(f"Image output must use one of these extensions: {supported}")
    if output.exists() and not args.force:
        raise SystemExit(f"Image output already exists: {output}. Use --force to replace it.")

    references: list[Path] = []
    for raw in args.reference or []:
        path = Path(raw).expanduser()
        path = (path if path.is_absolute() else cwd / path).resolve()
        if not path.is_file():
            raise SystemExit(f"Reference image does not exist: {path}")
        if path.suffix.lower() not in IMAGE_EXTENSIONS:
            raise SystemExit(f"Reference image has an unsupported extension: {path}")
        references.append(path)
    return output, references


def cmd_image(args: argparse.Namespace) -> int:
    task = task_from_parts(args.task_parts, args.task)
    if not task:
        raise SystemExit("Provide an image brief after -- or with --task.")
    cwd = Path(args.cwd).expanduser().resolve()
    if not cwd.is_dir():
        raise SystemExit(f"Working directory does not exist: {cwd}")
    output, references = image_paths(args, cwd)
    agent, capability = choose_image_agent(
        args.target or "auto",
        args.caller,
        allow_missing_command=args.dry_run,
    )
    prompt = build_image_prompt(
        args.caller,
        task,
        output,
        references,
        image_tool=str(capability["tool"]) if capability.get("tool") else None,
        image_model=args.image_model,
    )
    cmd = command_for_agent(
        agent,
        cwd=cwd,
        mode="work",
        prompt=prompt,
        model=args.model,
        trust=args.trust,
        reasoning=args.reasoning,
        attachments=references,
    )
    if args.dry_run:
        if not capability.get("available"):
            print(f"# warning: {agent.display} image tool was not statically detected")
        print(shlex.join(cmd))
        return 0

    output.parent.mkdir(parents=True, exist_ok=True)
    if not capability.get("available"):
        print(
            f"warning: {agent.display} image tool was not statically detected; trying the explicitly selected harness.",
            file=sys.stderr,
        )
    if args.background:
        job_id, pid = create_background_job(
            agent,
            "work",
            cmd,
            cwd,
            task,
            caller=args.caller,
            model=args.model,
            reasoning=args.reasoning,
            trust=args.trust,
            prompt=prompt,
            job_kind="image",
            artifact_path=output,
            reference_paths=references,
        )
        _, log_path = job_paths(job_id)
        print(style(f"Second Opinion image -> {agent.display} (background)", "cyan"))
        print(f"job: {job_id}")
        print(f"pid: {pid}")
        print(f"image: {output}")
        print(f"log: {log_path}")
        print(f"next: second-opinion wait {job_id}")
        if args.manager != "none":
            opened, detail = open_manager(args.manager, job_id)
            print(f"{'manager' if opened else 'manager-warning'}: {detail}")
        return 0

    before = artifact_fingerprint(output)
    print(style(f"Second Opinion image -> {agent.display}", "cyan"), file=sys.stderr)
    completed = subprocess.run(
        cmd,
        cwd=str(cwd),
        stdin=subprocess.DEVNULL,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if completed.stdout:
        print(completed.stdout, end="" if completed.stdout.endswith("\n") else "\n")
    if completed.stderr:
        print(completed.stderr, file=sys.stderr, end="" if completed.stderr.endswith("\n") else "\n")
    if completed.returncode:
        return completed.returncode
    artifact_error = validate_image_artifact(output, before)
    if artifact_error:
        print(f"Second Opinion artifact check failed: {artifact_error}", file=sys.stderr)
        return 1
    print(f"SECOND_OPINION_IMAGE: {output}")
    return 0


def create_parallel_team(args: argparse.Namespace, task: str, cwd: Path) -> tuple[str, list[str]]:
    target_name = args.target or "auto"
    if target_name == "auto":
        agent = choose_target(args.caller, task, include_self=args.include_self)
    else:
        agent = resolve_agent(target_name)
    if not shutil.which(agent.command) and not args.dry_run:
        raise SystemExit(f"{agent.display} CLI not found on PATH as `{agent.command}`.")
    assignments = team_assignments(args.strategy, args.count, args.role, args.mode)
    team_id = "team-" + time.strftime("%Y%m%d-%H%M%S") + f"-{uuid.uuid4().hex[:6]}"
    team_name = args.name or " ".join(task.split())[:72]
    job_ids: list[str] = []
    for index, (role, mode, instruction) in enumerate(assignments, start=1):
        worker_task = build_team_task(
            task,
            team_id=team_id,
            role=role,
            instruction=instruction,
            worker_index=index,
            worker_count=len(assignments),
        )
        prompt = build_prompt(args.caller, mode, worker_task)
        cmd = command_for_agent(
            agent,
            cwd=cwd,
            mode=mode,
            prompt=prompt,
            model=args.model,
            trust=args.trust,
            reasoning=args.reasoning,
        )
        if args.dry_run:
            print(f"# worker {index}/{len(assignments)} · {role} · {mode}")
            print(shlex.join(cmd))
            continue
        job_id, _ = create_background_job(
            agent,
            mode,
            cmd,
            cwd,
            worker_task,
            caller=args.caller,
            model=args.model,
            reasoning=args.reasoning,
            trust=args.trust,
            prompt=prompt,
            team_id=team_id,
            team_name=team_name,
            role=role,
            worker_index=index,
            worker_count=len(assignments),
        )
        job_ids.append(job_id)
    return team_id, job_ids


def cmd_team(args: argparse.Namespace) -> int:
    task = task_from_parts(args.task_parts, args.task)
    if not task:
        raise SystemExit("Provide a shared team objective after -- or with --task.")
    cwd = Path(args.cwd).expanduser().resolve()
    if not cwd.exists():
        raise SystemExit(f"Working directory does not exist: {cwd}")
    team_id, job_ids = create_parallel_team(args, task, cwd)
    if args.dry_run:
        return 0
    print(style(f"Second Opinion team -> {args.target} ({len(job_ids)} parallel workers)", "cyan"))
    print(f"team: {team_id}")
    for job in (read_job(job_id) for job_id in job_ids):
        print(f"  {job.get('worker_index')}/{job.get('worker_count')}  {job.get('id')}  {job.get('role')} ({job.get('mode')})")
    print(f"next: second-opinion wait {team_id}")
    if args.manager != "none" and job_ids:
        opened, detail = open_manager(args.manager, job_ids[0])
        print(f"{'manager' if opened else 'manager-warning'}: {detail}")
    return 0


def cmd_ask(args: argparse.Namespace) -> int:
    task = task_from_parts(args.task_parts, args.task)
    if not task:
        raise SystemExit("Provide a task after -- or with --task.")
    cwd = Path(args.cwd).expanduser().resolve()
    if not cwd.exists():
        raise SystemExit(f"Working directory does not exist: {cwd}")

    target_name = args.target or "auto"
    if target_name == "auto":
        agent = choose_target(args.caller, task, include_self=args.include_self)
    else:
        agent = resolve_agent(target_name)

    if not shutil.which(agent.command) and not args.dry_run:
        raise SystemExit(f"{agent.display} CLI not found on PATH as `{agent.command}`.")

    goal = args.goal.strip() if args.goal else None
    goal_command = native_goal_command(agent, goal)
    prompt = build_prompt(args.caller, args.mode, task, goal=goal, goal_command=goal_command)
    cmd = command_for_agent(
        agent,
        cwd=cwd,
        mode=args.mode,
        prompt=prompt,
        model=args.model,
        trust=args.trust,
        reasoning=args.reasoning,
    )

    if args.dry_run:
        print(shlex.join(cmd))
        return 0

    if args.background:
        return start_background_job(
            agent,
            args.mode,
            cmd,
            cwd,
            task,
            goal=goal,
            caller=args.caller,
            model=args.model,
            reasoning=args.reasoning,
            trust=args.trust,
            manager=args.manager,
            prompt=prompt,
        )

    print(style(f"Second Opinion -> {agent.display} ({args.mode})", "cyan"), file=sys.stderr)
    completed = subprocess.run(
        cmd,
        cwd=str(cwd),
        stdin=subprocess.DEVNULL,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )

    if completed.stdout:
        print(completed.stdout, end="" if completed.stdout.endswith("\n") else "\n")
    if completed.stderr:
        print(completed.stderr, file=sys.stderr, end="" if completed.stderr.endswith("\n") else "\n")
    return completed.returncode


def cmd_jobs(args: argparse.Namespace) -> int:
    jobs = list_jobs(include_archived=args.all)
    jobs = [ensure_job_worker(job) for job in jobs]
    if args.team:
        jobs = [job for job in jobs if job.get("team_id") == args.team]
    if args.running:
        jobs = [job for job in jobs if job_status(job) == "running"]
    if args.json:
        print(json.dumps({"jobs": jobs}, indent=2))
        return 0
    if not jobs:
        print("No Second Opinion jobs found.")
        return 0
    for job in jobs:
        print(f"{job['id']}  {job['status']:<8} {job['agent_name']} ({job['mode']})")
        if job.get("model"):
            print(f"  model: {job['model']}")
        if job.get("reasoning"):
            print(f"  reasoning: {job['reasoning']}")
        if job.get("team_id"):
            print(f"  team: {job['team_id']} · worker {job.get('worker_index')}/{job.get('worker_count')} · {job.get('role')}")
        if job.get("kind") == "image" and job.get("artifact_path"):
            print(f"  image: {job['artifact_path']}")
        print(f"  log: {job['log_path']}")
    return 0


def cmd_wait(args: argparse.Namespace) -> int:
    team = [job for job in list_jobs() if job.get("team_id") == args.job_id]
    if team:
        while any(job_status(job) in {"running", "queued"} for job in team):
            for job in team:
                ensure_job_worker(job)
            time.sleep(args.interval)
            team = [job for job in list_jobs() if job.get("team_id") == args.job_id]
        for index, job in enumerate(sorted(team, key=lambda item: int(item.get("worker_index") or 0))):
            if index:
                print()
            print(f"{'=' * 72}\n{job.get('role')} · {job.get('agent_name')} · {job_status(job)}\n{'=' * 72}")
            log_path = Path(str(job["log_path"]))
            if log_path.exists():
                print(log_path.read_text(encoding="utf-8"), end="")
            else:
                print("Log missing.")
        return 0 if all(job_status(job) == "finished" for job in team) else 1

    job = read_job(args.job_id)
    while job_status(job) in {"running", "queued"}:
        job = ensure_job_worker(job)
        time.sleep(args.interval)
        job = read_job(args.job_id)

    log_path = Path(str(job["log_path"]))
    if log_path.exists():
        print(log_path.read_text(encoding="utf-8"), end="")
    else:
        print(f"Job finished, but log file is missing: {log_path}")
        return 1
    return 0


def cmd_commands(_: argparse.Namespace) -> int:
    print("Main CLI:")
    print("  curl -fsSL https://second-opinion.ssh.codes/install.sh | bash")
    print()
    print("Install for detected agents:")
    print("  curl -fsSL https://second-opinion.ssh.codes/install.sh | bash -s -- --yes")
    print()
    print("Install for every supported agent:")
    print("  curl -fsSL https://second-opinion.ssh.codes/install.sh | bash -s -- --all --yes")
    print()
    print("Update an existing install:")
    print("  second-opinion update")
    print("  second-opinion update --all-skills")
    print()
    print("Install a specific agent skill:")
    for key in AGENTS:
        print(f"  curl -fsSL https://second-opinion.ssh.codes/install.sh | bash -s -- --agent {key} --yes")
    print()
    print("Install on a remote machine over SSH:")
    print("  ssh dev@server 'curl -fsSL https://second-opinion.ssh.codes/install.sh | bash -s -- --all --yes'")
    print()
    print("Delegate from an agent:")
    print('  second-opinion ask auto --from codex --cwd "$PWD" --mode consult --background -- "Review this change."')
    print('  second-opinion ask auto --background --manager terminal -- "Open the terminal manager."')
    print('  second-opinion ask auto --background --manager none -- "Run without opening a window."')
    print('  second-opinion team codex --from claude --count 5 --model gpt-5.6-luna --reasoning xhigh -- "Build and verify this in parallel."')
    print('  second-opinion benchmarks --kind models --sort coding --max-cost 0.50 --json')
    print('  second-opinion benchmarks --kind agents --sort agent-score --json')
    print('  second-opinion image-tools --available --json')
    print('  second-opinion image auto --from claude --cwd "$PWD" --output design/concept.png --reference current.png --background -- "Create a stronger visual direction."')
    print("  second-opinion jobs")
    print("  second-opinion wait JOB_ID")
    print("  second-opinion app")
    print("  second-opinion tui")
    return 0


def cmd_doctor(_: argparse.Namespace) -> int:
    rc = cmd_status(argparse.Namespace(json=False))
    bin_path = shutil.which("second-opinion")
    print()
    if bin_path:
        print(f"{style('ok', 'green')} second-opinion is on PATH: {bin_path}")
    else:
        print(f"{style('warn', 'yellow')} second-opinion is not on PATH. Add ~/.local/bin to PATH.")
        rc = 1
    return rc


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="second-opinion",
        description="Install and use AI coding agents as opt-in subagents for each other.",
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True)

    status = sub.add_parser("status", help="Show detected agents and installed skills.")
    status.add_argument("--json", action="store_true", help="Emit machine-readable JSON.")
    status.set_defaults(func=cmd_status)

    install = sub.add_parser("install", help="Install Second Opinion skills.")
    install.add_argument("--agent", action="append", choices=agent_choices(), help="Install one agent skill. Repeatable.")
    install.add_argument("--all", action="store_true", help="Install all supported agent skills.")
    install.add_argument("--yes", "-y", action="store_true", help="Skip interactive selection and install detected agents.")
    install.add_argument("--force", action="store_true", help="Replace an existing non-generated skill file.")
    install.add_argument("--dry-run", action="store_true", help="Show what would be written.")
    install.add_argument("--skip-freedomclaude", action="store_true", help=argparse.SUPPRESS)
    install.add_argument("--home", help="Override home directory, useful for tests.")
    install.set_defaults(func=cmd_install)

    update = sub.add_parser("update", help="Update the installed Second Opinion CLI from the published site.")
    update.add_argument("--base-url", default=base_url_from_env(), help="Download host. Defaults to SECOND_OPINION_BASE_URL or the public site.")
    update.add_argument("--path", help="CLI file to update. Defaults to the current executable.")
    update.add_argument("--force", action="store_true", help="Reinstall even when the downloaded version is not newer.")
    update.add_argument("--dry-run", action="store_true", help="Show what would be updated without replacing files.")
    update.add_argument("--skip-skills", action="store_true", help="Update only the CLI, without refreshing managed skill files.")
    update.add_argument("--all-skills", action="store_true", help="Refresh all supported skill files after updating.")
    update.add_argument("--skip-freedomclaude", action="store_true", help=argparse.SUPPRESS)
    update.add_argument("--freedomclaude-base-url", help=argparse.SUPPRESS)
    update.add_argument("--home", help="Override home directory, useful for tests.")
    update.set_defaults(func=cmd_update)

    uninstall = sub.add_parser("uninstall", help="Remove Second Opinion managed skills.")
    uninstall.add_argument("--agent", action="append", choices=agent_choices(), help="Remove one agent skill. Repeatable.")
    uninstall.add_argument("--all", action="store_true", help="Remove all managed skill files.")
    uninstall.add_argument("--dry-run", action="store_true", help="Show what would be removed.")
    uninstall.add_argument("--home", help="Override home directory, useful for tests.")
    uninstall.set_defaults(func=cmd_uninstall)

    choose = sub.add_parser("choose", help="Choose the best installed subagent for a task.")
    choose.add_argument("--from", dest="caller", help="Calling agent to exclude when possible.")
    choose.add_argument("--include-self", action="store_true", help="Allow choosing the calling agent.")
    choose.add_argument("--task", help="Task text.")
    choose.add_argument("--json", action="store_true")
    choose.add_argument("task_parts", nargs="*")
    choose.set_defaults(func=cmd_choose)

    ask = sub.add_parser("ask", help="Run another agent as a scoped subagent.")
    ask.add_argument("target", nargs="?", help="Target agent: auto, codex, claude, opencode, grok, or antigravity.", default="auto")
    ask.add_argument("--from", dest="caller", help="Calling agent name.")
    ask.add_argument("--cwd", default=".", help="Workspace directory for the subagent.")
    ask.add_argument("--mode", choices=("consult", "work"), default="work", help="work is the default and may edit; consult is read-only by prompt/policy.")
    ask.add_argument("--model", help="Pass a model override to the target CLI when supported.")
    ask.add_argument("--reasoning", "--effort", help="Pass provider-native reasoning effort/variant to the target harness.")
    ask.add_argument("--timeout", type=int, help="Deprecated and ignored. Subagents run without a timeout.")
    ask.add_argument("--task", help="Task text.")
    ask.add_argument("--goal", help="Optional delegated goal. Use only when the user explicitly asks for goal-backed Second Opinion work.")
    ask.add_argument("--dry-run", action="store_true", help="Print the underlying agent command.")
    ask.add_argument("--background", action="store_true", help="Start the subagent in the background and return a job id immediately.")
    ask.add_argument(
        "--manager",
        "--ui",
        choices=MANAGER_CHOICES,
        default=default_manager(),
        help="For background tasks, open the native app (default), a terminal manager, or no window.",
    )
    ask.add_argument("--no-window", dest="manager", action="store_const", const="none", help="Alias for --manager none.")
    ask.add_argument("--include-self", action="store_true", help="Allow auto to choose the caller if needed.")
    ask.add_argument("--trust", action="store_true", help="Allow high-permission work-mode flags for agents that support them.")
    ask.add_argument("task_parts", nargs="*")
    ask.set_defaults(func=cmd_ask)

    team = sub.add_parser("team", help="Spawn a parallel team of specialized workers through native agent harnesses.")
    team.add_argument("target", nargs="?", default="auto", help="Worker harness: auto, codex, claude, opencode, grok, or antigravity.")
    team.add_argument("--from", dest="caller", help="Orchestrating agent name.")
    team.add_argument("--cwd", default=".", help="Shared workspace directory.")
    team.add_argument("--count", type=int, default=5, help="Number of parallel workers (1-32, default 5).")
    team.add_argument("--strategy", choices=tuple(TEAM_STRATEGIES), default="balanced", help="Automatic role mix for the worker pool.")
    team.add_argument("--role", action="append", help="Custom worker role/instruction. Repeatable; roles cycle when count is larger.")
    team.add_argument("--mode", choices=("consult", "work"), help="Force every worker into one mode instead of strategy-specific modes.")
    team.add_argument("--model", help="Model override passed to every worker harness.")
    team.add_argument("--reasoning", "--effort", help="Provider-native effort/variant passed to every worker.")
    team.add_argument("--name", help="Short team label shown in task metadata.")
    team.add_argument("--task", help="Shared team objective.")
    team.add_argument("--dry-run", action="store_true", help="Print every native harness command without starting workers.")
    team.add_argument("--include-self", action="store_true", help="Allow auto routing to use the orchestrator's harness.")
    team.add_argument("--trust", action="store_true", help="Allow high-permission work-mode flags where supported.")
    team.add_argument(
        "--manager",
        "--ui",
        choices=MANAGER_CHOICES,
        default=default_manager(),
        help="Open the native app (default), terminal manager, or no window after spawning the team.",
    )
    team.add_argument("--no-window", dest="manager", action="store_const", const="none", help="Alias for --manager none.")
    team.add_argument("task_parts", nargs="*")
    team.set_defaults(func=cmd_team)

    benchmarks = sub.add_parser("benchmarks", help="Query keyless public Artificial Analysis model and coding-agent scores.")
    benchmarks.add_argument("--kind", choices=("models", "agents", "all"), default="models", help="Model indices, harness-specific Coding Agent Index, or both.")
    benchmarks.add_argument("--sort", choices=("intelligence", "coding", "agentic", "agent-score", "cost", "speed", "time", "name"), default="coding")
    benchmarks.add_argument("--query", help="Filter by model, creator, or harness text.")
    benchmarks.add_argument("--max-cost", type=float, help="Maximum average USD cost per benchmark task.")
    benchmarks.add_argument("--min-intelligence", type=float)
    benchmarks.add_argument("--min-coding", type=float)
    benchmarks.add_argument("--min-agentic", type=float)
    benchmarks.add_argument("--min-agent-score", type=float, help="Minimum Artificial Analysis Coding Agent Index (0-100).")
    benchmarks.add_argument("--limit", type=int, default=15, help="Maximum rows to return (default 15).")
    benchmarks.add_argument("--refresh", action="store_true", help="Refresh public data even when the six-hour cache is fresh.")
    benchmarks.add_argument("--offline", action="store_true", help="Use cached data without a network request.")
    benchmarks.add_argument("--json", action="store_true", help="Emit machine-readable data for an orchestrator model.")
    benchmarks.set_defaults(func=cmd_benchmarks)

    image_tools = sub.add_parser("image-tools", help="Discover native image-generation tools exposed by coding harnesses.")
    image_tools.add_argument("--available", action="store_true", help="Only show harnesses with a detected or declared image tool.")
    image_tools.add_argument("--json", action="store_true", help="Emit machine-readable capability data for an orchestrator model.")
    image_tools.set_defaults(func=cmd_image_tools)

    image = sub.add_parser("image", help="Create or edit an image through a coding harness's native image tool.")
    image.add_argument("target", nargs="?", default="auto", help="Image-capable harness: auto, codex, claude, opencode, grok, or antigravity.")
    image.add_argument("--from", dest="caller", help="Orchestrating agent name.")
    image.add_argument("--cwd", default=".", help="Workspace directory; the output must stay inside it.")
    image.add_argument("--output", required=True, help="Required PNG, JPEG, WebP, or GIF artifact path inside the workspace.")
    image.add_argument("--reference", action="append", help="Local reference image. Repeatable; native attachment flags are used where supported.")
    image.add_argument("--model", help="Coding-harness model supervising the image task.")
    image.add_argument("--image-model", help="Optional native image generator requested in the worker prompt.")
    image.add_argument("--reasoning", "--effort", help="Provider-native reasoning effort/variant for the coding harness.")
    image.add_argument("--task", help="Image creation or editing brief.")
    image.add_argument("--force", action="store_true", help="Allow replacing an existing output artifact.")
    image.add_argument("--dry-run", action="store_true", help="Print the native harness command without starting it or creating directories.")
    image.add_argument("--background", action="store_true", help="Create a managed image task and return immediately.")
    image.add_argument("--trust", action="store_true", help="Allow high-permission work-mode flags where supported.")
    image.add_argument(
        "--manager",
        "--ui",
        choices=MANAGER_CHOICES,
        default=default_manager(),
        help="For background tasks, open the native app (default), terminal manager, or no window.",
    )
    image.add_argument("--no-window", dest="manager", action="store_const", const="none", help="Alias for --manager none.")
    image.add_argument("task_parts", nargs="*")
    image.set_defaults(func=cmd_image)

    jobs = sub.add_parser("jobs", help="List background subagent jobs.")
    jobs.add_argument("--json", action="store_true", help="Emit machine-readable JSON.")
    jobs.add_argument("--running", action="store_true", help="Only show jobs that are still running.")
    jobs.add_argument("--all", action="store_true", help="Include archived jobs.")
    jobs.add_argument("--team", help="Only show workers belonging to this team id.")
    jobs.set_defaults(func=cmd_jobs)

    wait = sub.add_parser("wait", help="Wait for a background subagent job and print its log.")
    wait.add_argument("job_id", help="Job id or team id returned by a background run.")
    wait.add_argument("--interval", type=float, default=2.0, help="Polling interval in seconds.")
    wait.set_defaults(func=cmd_wait)

    app = sub.add_parser("app", help="Open the lightweight native Second Opinion task manager.")
    app.add_argument("--job", help="Select a task when the manager opens.")
    app.add_argument("--foreground", action="store_true", help="Run the app in this process instead of detaching it.")
    app.set_defaults(func=cmd_app)

    tui = sub.add_parser("tui", help="Run the task manager as an interactive terminal CLI.")
    tui.add_argument("--job", help="Select a task when the terminal manager opens.")
    tui.set_defaults(func=cmd_tui)

    commands = sub.add_parser("commands", help="Print copy-paste install and usage commands.")
    commands.set_defaults(func=cmd_commands)

    doctor = sub.add_parser("doctor", help="Run basic installation checks.")
    doctor.set_defaults(func=cmd_doctor)

    return parser


def main(argv: list[str] | None = None) -> int:
    actual_argv = list(sys.argv[1:] if argv is None else argv)
    if actual_argv[:1] == ["_run-job"]:
        if len(actual_argv) != 2:
            raise SystemExit("Internal worker requires a job id.")
        return run_job_worker(actual_argv[1])
    if actual_argv[:1] == ["_app"]:
        job_id = None
        if len(actual_argv) == 3 and actual_argv[1] == "--job":
            job_id = actual_argv[2]
        elif len(actual_argv) != 1:
            raise SystemExit("Invalid internal app arguments.")
        return run_native_app(job_id)
    if actual_argv[:1] in (["ask"], ["team"], ["image"]) and "--" in actual_argv:
        separator = actual_argv.index("--")
        task_text = " ".join(actual_argv[separator + 1 :])
        actual_argv = [*actual_argv[:separator], "--task", task_text]
    parser = build_parser()
    args = parser.parse_args(actual_argv)
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
